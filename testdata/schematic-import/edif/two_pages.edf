(edif two_pages
  (edifVersion 2 0 0)
  (edifLevel 0)
  (keywordMap (keywordLevel 0))
  (status (written (timeStamp 2026 10 19 12 0 0) (program "handwritten")))
  (comment "Written by hand for circuitRF's tests: one net carried from page to page by an off-page connector.")
  (library PARTS
    (edifLevel 0)
    (technology (numberDefinition (scale 1 (e 254 -6) (unit DISTANCE))))
    (cell R (cellType GENERIC)
      (view (rename &Normal "Normal") (viewType SCHEMATIC)
        (interface
          (port &1 (designator "1") (property PINTYPE (string "PAS")))
          (port &2 (designator "2") (property PINTYPE (string "PAS"))))
        (contents
          (figure BODY (rectangle (pt 5 2) (pt 15 -2)))
          (portImplementation &1 (connectLocation (figure DOT (dot (pt 0 0))))
            (figure LEAD (path (pointList (pt 0 0) (pt 5 0)))))
          (portImplementation &2 (connectLocation (figure DOT (dot (pt 20 0))))
            (figure LEAD (path (pointList (pt 20 0) (pt 15 0)))))))))
  (library DESIGN
    (edifLevel 0)
    (technology (numberDefinition (scale 1 (e 254 -6) (unit DISTANCE))))
    (cell two_pages (cellType GENERIC)
      (view (rename &Normal "Normal") (viewType SCHEMATIC)
        (interface)
        (contents
          (page (rename &PAGE1 "PAGE1")
            (instance &R1 (viewRef &Normal (cellRef R (libraryRef PARTS)))
              (transform (orientation R0) (origin (pt 100 -100)))
              (designator "R1")
              (property Value (string "100")))
            (portImplementation &SIG (connectLocation (figure DOT (dot (pt 80 -100))))
              (instance &OP1 (viewRef &Normal (cellRef SIG_OFF_PAGE_CONNECTOR (libraryRef PARTS)))
                (transform (orientation R0) (origin (pt 80 -100)))))
            (portImplementation &GND (connectLocation (figure DOT (dot (pt 140 -100))))
              (instance &PWR1 (viewRef &Normal (cellRef GND_SYM (libraryRef PARTS)))
                (transform (orientation R90) (origin (pt 140 -100)))))
            (net N00001
              (joined (portRef &1 (instanceRef &R1)) (portRef &SIG))
              (figure WIRE (path (pointList (pt 80 -100) (pt 100 -100)))))
            (net N00002
              (joined (portRef &2 (instanceRef &R1)) (portRef &GND))
              (figure WIRE (path (pointList (pt 120 -100) (pt 140 -100))))))
          (page (rename &PAGE2 "PAGE2")
            (instance &R2 (viewRef &Normal (cellRef R (libraryRef PARTS)))
              (transform (orientation R0) (origin (pt 100 -100)))
              (designator "R2")
              (property Value (string "200")))
            (portImplementation &SIG (connectLocation (figure DOT (dot (pt 80 -100))))
              (instance &OP2 (viewRef &Normal (cellRef SIG_OFF_PAGE_CONNECTOR (libraryRef PARTS)))
                (transform (orientation MY) (origin (pt 80 -100)))))
            (portImplementation &GND (connectLocation (figure DOT (dot (pt 140 -100))))
              (instance &PWR2 (viewRef &Normal (cellRef GND_SYM (libraryRef PARTS)))
                (transform (orientation R90) (origin (pt 140 -100)))))
            (net N00003
              (joined (portRef &1 (instanceRef &R2)) (portRef &SIG))
              (figure WIRE (path (pointList (pt 80 -100) (pt 100 -100)))))
            (net N00004
              (joined (portRef &2 (instanceRef &R2)) (portRef &GND))
              (figure WIRE (path (pointList (pt 120 -100) (pt 140 -100))))))))))
  (design two_pages (cellRef two_pages (libraryRef DESIGN))))
