(edif escapes
  (edifVersion 2 0 0)
  (edifLevel 0)
  (keywordMap (keywordLevel 0))
  (status (written (timeStamp 2026 10 19 12 0 0) (program "handwritten")))
  (comment "Written by hand for circuitRF's tests: escaped text runs - a CR LF, a UTF-8 run and a code-page run.")
  (library PARTS
    (edifLevel 0)
    (technology (numberDefinition (scale 1 (e 254 -6) (unit DISTANCE))))
    (cell R (cellType GENERIC)
      (view (rename &Normal "Normal") (viewType SCHEMATIC)
        (interface
          (port &1 (designator "1") (property PINTYPE (string "PAS")))
          (port &2 (designator "2") (property PINTYPE (string "PAS"))))
        (contents
          (figure BODY (rectangle (pt 5 2) (pt 15 -2)))
          (portImplementation &1 (connectLocation (figure DOT (dot (pt 0 0))))
            (figure LEAD (path (pointList (pt 0 0) (pt 5 0)))))
          (portImplementation &2 (connectLocation (figure DOT (dot (pt 20 0))))
            (figure LEAD (path (pointList (pt 20 0) (pt 15 0))))))))
    (cell C (cellType GENERIC)
      (view (rename &Normal "Normal") (viewType SCHEMATIC)
        (interface
          (port &1 (designator "1") (property PINTYPE (string "PAS")))
          (port &2 (designator "2") (property PINTYPE (string "PAS"))))
        (contents
          (figure BODY (path (pointList (pt 8 4) (pt 8 -4))) (path (pointList (pt 12 4) (pt 12 -4))))
          (portImplementation &1 (connectLocation (figure DOT (dot (pt 0 0))))
            (figure LEAD (path (pointList (pt 0 0) (pt 8 0)))))
          (portImplementation &2 (connectLocation (figure DOT (dot (pt 20 0))))
            (figure LEAD (path (pointList (pt 20 0) (pt 12 0)))))))))
  (library DESIGN
    (edifLevel 0)
    (technology (numberDefinition (scale 1 (e 254 -6) (unit DISTANCE))))
    (cell escapes (cellType GENERIC)
      (view (rename &Normal "Normal") (viewType SCHEMATIC)
        (interface)
        (contents
          (page (rename &PAGE1 "PAGE1")
            (instance &R1 (viewRef &Normal (cellRef R (libraryRef PARTS)))
              (transform (orientation R0) (origin (pt 100 -100)))
              (designator "R1")
              (property Value (string "1k")))
            (instance &C1 (viewRef &Normal (cellRef C (libraryRef PARTS)))
              (transform (orientation R0) (origin (pt 140 -100)))
              (designator "C1")
              (property Value (string "100%181%F")))
            (portImplementation (rename &P5V "+5V") (connectLocation (figure DOT (dot (pt 80 -100))))
              (instance &PWR1 (viewRef &Normal (cellRef RAIL_SYM (libraryRef PARTS)))
                (transform (orientation R0) (origin (pt 80 -100)))))
            (portImplementation &GND (connectLocation (figure DOT (dot (pt 180 -100))))
              (instance &PWR2 (viewRef &Normal (cellRef GND_SYM (libraryRef PARTS)))
                (transform (orientation R90) (origin (pt 180 -100)))))
            (net N00001
              (joined (portRef &1 (instanceRef &R1)) (portRef &P5V))
              (figure WIRE (path (pointList (pt 80 -100) (pt 100 -100)))))
            (net N00002
              (joined (portRef &2 (instanceRef &R1)) (portRef &1 (instanceRef &C1)))
              (figure WIRE (path (pointList (pt 120 -100) (pt 140 -100)))))
            (net N00003
              (joined (portRef &2 (instanceRef &C1)) (portRef &GND))
              (figure WIRE (path (pointList (pt 160 -100) (pt 180 -100)))))
            (commentGraphics
              (annotate (stringDisplay "First line%13%%10%Second line%13%%10%" (display TEXT (origin (pt 100 -60)))))
              (annotate (stringDisplay "R = 50 %206%%169%" (display TEXT (origin (pt 100 -70)))))))))))
  (design escapes (cellRef escapes (libraryRef DESIGN))))
