(edif opamp_units
  (edifVersion 2 0 0)
  (edifLevel 0)
  (keywordMap (keywordLevel 0))
  (status (written (timeStamp 2026 10 19 12 0 0) (program "handwritten")))
  (comment "Written by hand for circuitRF's tests: a two-unit part, unit A placed MX and unit B R90; hidden power pins.")
  (library PARTS
    (edifLevel 0)
    (technology (numberDefinition (scale 1 (e 254 -6) (unit DISTANCE))))
    (cell R (cellType GENERIC)
      (view (rename &Normal "Normal") (viewType SCHEMATIC)
        (interface
          (port &1 (designator "1") (property PINTYPE (string "PAS")))
          (port &2 (designator "2") (property PINTYPE (string "PAS"))))
        (contents
          (figure BODY (rectangle (pt 5 2) (pt 15 -2)))
          (portImplementation &1 (connectLocation (figure DOT (dot (pt 0 0))))
            (figure LEAD (path (pointList (pt 0 0) (pt 5 0)))))
          (portImplementation &2 (connectLocation (figure DOT (dot (pt 20 0))))
            (figure LEAD (path (pointList (pt 20 0) (pt 15 0))))))))
    (cell OPAMP_DUAL (cellType GENERIC)
      (view (rename &Normal "Normal") (viewType SCHEMATIC)
        (interface
          (port (rename &INP "+") (property PINTYPE (string "IN")) (property PackagePortNumbers (string "3,5")))
          (port (rename &INN "-") (property PINTYPE (string "IN")) (property PackagePortNumbers (string "2,6")))
          (port &OUT (property PINTYPE (string "OUT")) (property PackagePortNumbers (string "1,7")))
          (port &VCC (designator "8") (property PINTYPE (string "POWER")) (property IMPLICITPORTCLASS (string "VCC")))
          (port &GND (designator "4") (property PINTYPE (string "POWER")) (property IMPLICITPORTCLASS (string "GND"))))
        (contents
          (figure BODY (polygon (pointList (pt 0 10) (pt 0 -10) (pt 20 0))))
          (portImplementation &INN (connectLocation (figure DOT (dot (pt -10 5))))
            (figure LEAD (path (pointList (pt -10 5) (pt 0 5)))))
          (portImplementation &INP (connectLocation (figure DOT (dot (pt -10 -5))))
            (figure LEAD (path (pointList (pt -10 -5) (pt 0 -5)))))
          (portImplementation &OUT (connectLocation (figure DOT (dot (pt 30 0))))
            (figure LEAD (path (pointList (pt 30 0) (pt 20 0)))))
          (portImplementation &VCC (connectLocation (figure DOT (dot (pt 10 5)))))
          (portImplementation &GND (connectLocation (figure DOT (dot (pt 10 -5)))))))))
  (library DESIGN
    (edifLevel 0)
    (technology (numberDefinition (scale 1 (e 254 -6) (unit DISTANCE))))
    (cell opamp_units (cellType GENERIC)
      (view (rename &Normal "Normal") (viewType SCHEMATIC)
        (interface)
        (contents
          (page (rename &PAGE1 "PAGE1")
            (instance (rename &U1A "U1A") (viewRef &Normal (cellRef OPAMP_DUAL (libraryRef PARTS)))
              (transform (orientation MX) (origin (pt 100 -100)))
              (designator "U1A")
              (property Designator (string "A"))
              (property PositionInPackage (integer 0))
              (property Value (string "OPAMP_DUAL")))
            (instance (rename &U1B "U1B") (viewRef &Normal (cellRef OPAMP_DUAL (libraryRef PARTS)))
              (transform (orientation R90) (origin (pt 200 -100)))
              (designator "U1B")
              (property Designator (string "B"))
              (property PositionInPackage (integer 1))
              (property Value (string "OPAMP_DUAL")))
            (instance &R1 (viewRef &Normal (cellRef R (libraryRef PARTS)))
              (transform (orientation R270) (origin (pt 60 -95)))
              (designator "R1")
              (property Value (string "10k")))
            (portImplementation &GND (connectLocation (figure DOT (dot (pt 60 -130))))
              (instance &PWR1 (viewRef &Normal (cellRef GND_SYM (libraryRef PARTS)))
                (transform (orientation R0) (origin (pt 60 -130)))))
            (net N00001
              (joined (portRef &OUT (instanceRef &U1A)) (portRef &INN (instanceRef &U1A)) (portRef &INP (instanceRef &U1B)))
              (figure WIRE
                (path (pointList (pt 130 -100) (pt 140 -100) (pt 140 -120) (pt 80 -120) (pt 80 -105) (pt 90 -105)))
                (path (pointList (pt 140 -100) (pt 205 -100) (pt 205 -110))))
              (figure JUNCTION (dot (pt 140 -100))))
            (net (rename &OUT_NET "OUT")
              (joined (portRef &OUT (instanceRef &U1B)) (portRef &INN (instanceRef &U1B)))
              (figure WIRE
                (path (pointList (pt 200 -70) (pt 200 -60) (pt 230 -60) (pt 230 -120) (pt 195 -120) (pt 195 -110)))))
            (net N00003
              (joined (portRef &INP (instanceRef &U1A)) (portRef &1 (instanceRef &R1)))
              (figure WIRE (path (pointList (pt 90 -95) (pt 60 -95)))))
            (net N00004
              (joined (portRef &2 (instanceRef &R1)) (portRef &GND))
              (figure WIRE (path (pointList (pt 60 -115) (pt 60 -130))))))))))
  (design opamp_units (cellRef opamp_units (libraryRef DESIGN))))
