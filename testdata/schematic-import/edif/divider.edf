(edif divider
  (edifVersion 2 0 0)
  (edifLevel 0)
  (keywordMap (keywordLevel 0))
  (status (written (timeStamp 2026 10 19 12 0 0) (program "handwritten")))
  (comment "Written by hand for circuitRF's tests, following the structure brief-schimp-3 section 2 describes.")
  (library PARTS
    (edifLevel 0)
    (technology (numberDefinition (scale 1 (e 254 -6) (unit DISTANCE))))
    (cell R (cellType GENERIC)
      (view (rename &Normal "Normal") (viewType SCHEMATIC)
        (interface
          (port &1 (designator "1") (property PINTYPE (string "PAS")))
          (port &2 (designator "2") (property PINTYPE (string "PAS"))))
        (contents
          (figure BODY (rectangle (pt 5 2) (pt 15 -2)))
          (portImplementation &1 (connectLocation (figure DOT (dot (pt 0 0))))
            (figure LEAD (path (pointList (pt 0 0) (pt 5 0)))))
          (portImplementation &2 (connectLocation (figure DOT (dot (pt 20 0))))
            (figure LEAD (path (pointList (pt 20 0) (pt 15 0))))))))
    (cell C (cellType GENERIC)
      (view (rename &Normal "Normal") (viewType SCHEMATIC)
        (interface
          (port &1 (designator "1") (property PINTYPE (string "PAS")))
          (port &2 (designator "2") (property PINTYPE (string "PAS"))))
        (contents
          (figure BODY (path (pointList (pt 8 4) (pt 8 -4))) (path (pointList (pt 12 4) (pt 12 -4))))
          (portImplementation &1 (connectLocation (figure DOT (dot (pt 0 0))))
            (figure LEAD (path (pointList (pt 0 0) (pt 8 0)))))
          (portImplementation &2 (connectLocation (figure DOT (dot (pt 20 0))))
            (figure LEAD (path (pointList (pt 20 0) (pt 12 0))))))))
    (cell TITLEBLOCK (cellType GENERIC)
      (view (rename &Normal "Normal") (viewType SCHEMATIC)
        (interface)
        (contents (figure BORDER (rectangle (pt 0 0) (pt 300 -60)))))))
  (library DESIGN
    (edifLevel 0)
    (technology (numberDefinition (scale 1 (e 254 -6) (unit DISTANCE))))
    (cell (rename &divider "divider") (cellType GENERIC)
      (view (rename &Normal "Normal") (viewType SCHEMATIC)
        (interface)
        (contents
          (page (rename &PAGE1 "PAGE1")
            (pageSize (rectangle (pt 0 0) (pt 1100 -850)))
            (instance &TB1 (viewRef &Normal (cellRef TITLEBLOCK (libraryRef PARTS)))
              (transform (orientation R0) (origin (pt 700 -780))))
            (instance &R1 (viewRef &Normal (cellRef R (libraryRef PARTS)))
              (transform (orientation R90) (origin (pt 100 -110)))
              (designator "R1")
              (property Value (string "1k")))
            (instance &R2 (viewRef &Normal (cellRef R (libraryRef PARTS)))
              (transform (orientation R270) (origin (pt 100 -130)))
              (designator "R2")
              (property Value (string "2k")))
            (instance &C1 (viewRef &Normal (cellRef C (libraryRef PARTS)))
              (transform (orientation R270) (origin (pt 140 -120)))
              (designator "C1")
              (property Value (string "10n")))
            (portImplementation (rename &P5V "+5V") (connectLocation (figure DOT (dot (pt 100 -60))))
              (instance &PWR1 (viewRef &Normal (cellRef RAIL_SYM (libraryRef PARTS)))
                (transform (orientation R0) (origin (pt 100 -60)))))
            (portImplementation &GND (connectLocation (figure DOT (dot (pt 100 -170))))
              (instance &PWR2 (viewRef &Normal (cellRef GND_SYM (libraryRef PARTS)))
                (transform (orientation R0) (origin (pt 100 -170)))))
            (portImplementation &GND (connectLocation (figure DOT (dot (pt 140 -170))))
              (instance &PWR3 (viewRef &Normal (cellRef GND_SYM (libraryRef PARTS)))
                (transform (orientation R0) (origin (pt 140 -170)))))
            (net N00001
              (joined (portRef &2 (instanceRef &R1)) (portRef &P5V))
              (figure WIRE (path (pointList (pt 100 -60) (pt 100 -90)))))
            (net (rename &VOUT "VOUT")
              (joined (portRef &1 (instanceRef &R1)) (portRef &1 (instanceRef &R2)) (portRef &1 (instanceRef &C1)))
              (figure WIRE
                (path (pointList (pt 100 -110) (pt 100 -130)))
                (path (pointList (pt 100 -120) (pt 140 -120))))
              (figure JUNCTION (dot (pt 100 -120))))
            (net N00003
              (joined (portRef &2 (instanceRef &R2)) (portRef &2 (instanceRef &C1)) (portRef &GND))
              (figure WIRE
                (path (pointList (pt 100 -150) (pt 100 -170)))
                (path (pointList (pt 140 -140) (pt 140 -170)))))
            (commentGraphics
              (annotate (stringDisplay "Divider" (display TEXT (origin (pt 10 -10)))))))))))
  (design divider (cellRef &divider (libraryRef DESIGN))))
