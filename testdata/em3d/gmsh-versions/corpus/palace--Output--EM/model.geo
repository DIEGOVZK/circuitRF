// ---- disjoint by construction order: each solid loses what a higher-order solid takes -----
// metal takes precedence over dielectric: every metal is ranked above every dielectric (em-3d.md §6.3a)
s0[] = BooleanDifference{ Volume{s0[]}; Delete; }{ Volume{s2[], s3[], s4[], s5[], s6[], s7[], s8[], s9[], s10[], s11[], s12[], s13[]}; };

// ---- the air box, and the background: what no solid claims inside it --------------------
bx = newv; Box(bx) = {-300, -650, -500, 2200, 1300, 1100};
bg[] = BooleanDifference{ Volume{bx}; Delete; }{ Volume{s0[], s1[], s2[], s3[], s4[], s5[], s6[], s7[], s8[], s9[], s10[], s11[], s12[], s13[]}; };
// Conductors are voids: their surfaces carry Palace's conductivity boundary.
Recursive Delete { Volume{s1[], s3[], s5[], s6[], s7[], s8[], s9[], s10[], s11[], s12[], s13[]}; }

// ---- sheets and port sheets --------------------------------------------------------------
// port/1: from U1/Die Attach/1 to U1/Pad Metal/1
p = newp;
Point(p + 0) = {600, -450, 25};
Point(p + 1) = {600, 450, 25};
Point(p + 2) = {600, 450, 125};
Point(p + 3) = {600, -450, 125};
l = newc;
Line(l + 0) = {p + 0, p + 1};
Line(l + 1) = {p + 1, p + 2};
Line(l + 2) = {p + 2, p + 3};
Line(l + 3) = {p + 3, p + 0};
c = newcl; Curve Loop(c) = {l:l + 3};
s = news; Plane Surface(s) = {c}; p0[] = {s};
// port/2: from flange to lead
p = newp;
Point(p + 0) = {1800, -500, 0};
Point(p + 1) = {1800, 500, 0};
Point(p + 2) = {1800, 500, 65};
Point(p + 3) = {1800, -500, 65};
l = newc;
Line(l + 0) = {p + 0, p + 1};
Line(l + 1) = {p + 1, p + 2};
Line(l + 2) = {p + 2, p + 3};
Line(l + 3) = {p + 3, p + 0};
c = newcl; Curve Loop(c) = {l:l + 3};
s = news; Plane Surface(s) = {c}; p1[] = {s};

// ---- one fragment: imprints the shared faces and the sheets, splits no volume -------------
frag[] = BooleanFragments{ Volume{s0[], s2[], s4[], bg[]}; Delete; }{ Surface{p0[], p1[]}; Delete; };
allV[] = Volume{:};
allS[] = Surface{:};
single[] = CombinedBoundary{ Volume{allV[]}; };
For k In {0:#single[]-1}
  single[k] = Abs(single[k]);
EndFor
claimed[] = {};

// ---- surfaces, recovered by what circuitRF placed; each face claimed once ------------------
// air box xmin
f0[] = Surface In BoundingBox{-300 - e, -650 - e, -500 - e, -300 + e, 650 + e, 600 + e};
f0[] -= claimed[];
claimed[] += f0[];
// air box xmax
f1[] = Surface In BoundingBox{1900 - e, -650 - e, -500 - e, 1900 + e, 650 + e, 600 + e};
f1[] -= claimed[];
claimed[] += f1[];
// air box ymin
f2[] = Surface In BoundingBox{-300 - e, -650 - e, -500 - e, 1900 + e, -650 + e, 600 + e};
f2[] -= claimed[];
claimed[] += f2[];
// air box ymax
f3[] = Surface In BoundingBox{-300 - e, 650 - e, -500 - e, 1900 + e, 650 + e, 600 + e};
f3[] -= claimed[];
claimed[] += f3[];
// air box zmin
f4[] = Surface In BoundingBox{-300 - e, -650 - e, -500 - e, 1900 + e, 650 + e, -500 + e};
f4[] -= claimed[];
claimed[] += f4[];
// air box zmax
f5[] = Surface In BoundingBox{-300 - e, -650 - e, 600 - e, 1900 + e, 650 + e, 600 + e};
f5[] -= claimed[];
claimed[] += f5[];
// port/1
q0[] = Surface In BoundingBox{600 - e, -450 - e, 25 - e, 600 + e, 450 + e, 125 + e};
q0[] -= claimed[];
claimed[] += q0[];
// port/2
q1[] = Surface In BoundingBox{1800 - e, -500 - e, 0 - e, 1800 + e, 500 + e, 65 + e};
q1[] -= claimed[];
claimed[] += q1[];
voids[] = single[];
voids[] -= claimed[];
// conductor U1/Pad Metal/1
c6[] = Surface In BoundingBox{420 - e, -450 - e, 125 - e, 600 + e, 450 + e, 135 + e};
x[] = c6[];
x[] -= voids[];
c6[] -= x[];
c6[] -= claimed[];
