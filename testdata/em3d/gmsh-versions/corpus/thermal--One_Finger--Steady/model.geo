// Generated by circuitRF for its thermal solver (brief-em3d-74). Do not edit: circuitRF rewrites this file from
// the setup, and an unchanged file reuses the mesh beside it. Units: micrometres.
// Run by circuitRF as:  gmsh model.geo -3 -o model.msh    (writes entities.txt beside it)

SetFactory("OpenCASCADE");
Geometry.OCCBooleanPreserveNumbering = 1;
Geometry.OCCBoundsUseStl = 1;
e = 0.001;

// ---- solids, in construction order: conductors and dielectrics alike are meshed volumes ----
// substrate: Dielectric, Silicon carbide (4H, semi-insulating), order 1
v = newv; Box(v) = {0, 0, -100, 20, 50, 100};
s0[] = {v};
// epi: Dielectric, Gallium nitride, order 2
v = newv; Box(v) = {0, 0, 0, 20, 50, 1.5};
s1[] = {v};
// channel: Dielectric, Gallium nitride, order 3
v = newv; Box(v) = {12, 0, 1.25, 0.5, 25, 0.25};
s2[] = {v};
// passivation: Dielectric, Silicon nitride, order 4
v = newv; Box(v) = {0, 0, 1.5, 20, 50, 1};
s3[] = {v};
// source: Conductor, Gold, order 5
v = newv; Box(v) = {0, 0, 1.5, 10, 25, 2};
s4[] = {v};
// drain: Conductor, Gold, order 6
v = newv; Box(v) = {15.5, 0, 1.5, 4.5, 25, 2};
s5[] = {v};
// gate: Conductor, Gold, order 7
v = newv; Box(v) = {11.5, 0, 1.5, 0.5, 25, 0.6};
s6[] = {v};
// field_plate: Conductor, Gold, order 8
v = newv; Box(v) = {11.5, 0, 2.1, 2, 25, 0.2};
s7[] = {v};

// ---- disjoint by construction order: each solid loses what a higher-order solid takes -----
s1[] = BooleanDifference{ Volume{s1[]}; Delete; }{ Volume{s2[]}; };
s3[] = BooleanDifference{ Volume{s3[]}; Delete; }{ Volume{s4[], s5[], s6[], s7[]}; };

// ---- heat-source sheets: embedded surfaces --------------------------------------------------

// ---- one fragment: imprints the shared faces and the sheets, splits no volume -------------
frag[] = BooleanFragments{ Volume{s0[], s1[], s2[], s3[], s4[], s5[], s6[], s7[]}; Delete; }{ };
allV[] = Volume{:};
allS[] = Surface{:};
single[] = CombinedBoundary{ Volume{allV[]}; };
For k In {0:#single[]-1}
  single[k] = Abs(single[k]);
EndFor
claimed[] = {};

// ---- surfaces, recovered by what circuitRF placed ------------------------------------------
// face substrate/zmin: its exterior surfaces only (a boundary condition)
f0[] = Surface In BoundingBox{0 - e, 0 - e, -100 - e, 20 + e, 50 + e, -100 + e};
own[] = Abs(Boundary{ Volume{s0[]}; });
x[] = f0[];
x[] -= own[];
f0[] -= x[];
x[] = f0[];
x[] -= single[];
f0[] -= x[];
claimed[] += f0[];
// face passivation/zmax
f1[] = Surface In BoundingBox{0 - e, 0 - e, 2.5 - e, 20 + e, 50 + e, 2.5 + e};
own[] = Abs(Boundary{ Volume{s3[]}; });
x[] = f1[];
x[] -= own[];
f1[] -= x[];

// ---- physical groups: the solver's tags (groups.json) ---------------------------------------
Physical Volume("substrate", 1) = {s0[]};
Physical Volume("epi", 2) = {s1[]};
Physical Volume("channel", 3) = {s2[]};
Physical Volume("passivation", 4) = {s3[]};
Physical Volume("source", 5) = {s4[]};
Physical Volume("drain", 6) = {s5[]};
Physical Volume("gate", 7) = {s6[]};
Physical Volume("field_plate", 8) = {s7[]};
Physical Surface("substrate/zmin", 9) = {f0[]};
Physical Surface("passivation/zmax", 10) = {f1[]};

// ---- the entity table circuitRF checks before it believes this mesh ----------------------
Printf("# circuitRF entity table: group <attribute> <count> <volume tags lost in the fragment>") > "entities.txt";
lost[] = s0[];
lost[] -= allV[];
Printf("group 1 %g %g", #s0[], #lost[]) >> "entities.txt";
lost[] = s1[];
lost[] -= allV[];
Printf("group 2 %g %g", #s1[], #lost[]) >> "entities.txt";
lost[] = s2[];
lost[] -= allV[];
Printf("group 3 %g %g", #s2[], #lost[]) >> "entities.txt";
lost[] = s3[];
lost[] -= allV[];
Printf("group 4 %g %g", #s3[], #lost[]) >> "entities.txt";
lost[] = s4[];
lost[] -= allV[];
Printf("group 5 %g %g", #s4[], #lost[]) >> "entities.txt";
lost[] = s5[];
lost[] -= allV[];
Printf("group 6 %g %g", #s5[], #lost[]) >> "entities.txt";
lost[] = s6[];
lost[] -= allV[];
Printf("group 7 %g %g", #s6[], #lost[]) >> "entities.txt";
lost[] = s7[];
lost[] -= allV[];
Printf("group 8 %g %g", #s7[], #lost[]) >> "entities.txt";
Printf("group 9 %g 0", #f0[]) >> "entities.txt";
Printf("group 10 %g 0", #f1[]) >> "entities.txt";
Printf("all_volumes %g", #allV[]) >> "entities.txt";
Printf("classified_volumes %g", #s0[] + #s1[] + #s2[] + #s3[] + #s4[] + #s5[] + #s6[] + #s7[]) >> "entities.txt";
Printf("all_surfaces %g", #allS[]) >> "entities.txt";
Printf("single_sided %g", #single[]) >> "entities.txt";
// an unnamed single-sided surface is insulated in a thermal run, by definition
Printf("unclassified_single_sided 0") >> "entities.txt";

// ---- sizing: no wavelength -------------------------------------------------------------------
// Largest element 0.1 of the problem's largest side; at least 2 element(s) through each solid; 4 across each heat source's smaller side; growing by 1.3.
Mesh.MeshSizeMax = 10.35;
Mesh.MeshSizeFromPoints = 0;
Mesh.MeshSizeExtendFromBoundary = 0;
Mesh.MeshSizeFromCurvature = 12;
Field[1] = Constant; Field[1].VIn = 10; Field[1].VolumesList = {s0[]};
Field[2] = Constant; Field[2].VIn = 0.75; Field[2].VolumesList = {s1[]};
Field[3] = Constant; Field[3].VIn = 0.125; Field[3].VolumesList = {s2[]};
Field[4] = Constant; Field[4].VIn = 0.5; Field[4].VolumesList = {s3[]};
Field[5] = Constant; Field[5].VIn = 1; Field[5].VolumesList = {s4[]};
Field[6] = Constant; Field[6].VIn = 1; Field[6].VolumesList = {s5[]};
Field[7] = Constant; Field[7].VIn = 0.25; Field[7].VolumesList = {s6[]};
Field[8] = Constant; Field[8].VIn = 0.1; Field[8].VolumesList = {s7[]};
Field[9] = Box; Field[9].VIn = 0.5; Field[9].VOut = 10.35; Field[9].XMin = 10.5; Field[9].XMax = 15; Field[9].YMin = 0; Field[9].YMax = 27; Field[9].ZMin = 0.5; Field[9].ZMax = 2.5; Field[9].Thickness = 32.833333333;  // mesh region near_channel
Field[10] = Min; Field[10].FieldsList = {1, 2, 3, 4, 5, 6, 7, 8, 9};
Background Field = 10;
Mesh.ElementOrder = 2;
Mesh.HighOrderOptimize = 2;
Mesh.MshFileVersion = 2.2;
Mesh.Binary = 1;
