Line(l + 2) = {p + 2, p + 3};
Line(l + 3) = {p + 3, p + 0};
c = newcl; Curve Loop(c) = {l:l + 3};
cl[] += {c};
s = news; Plane Surface(s) = {cl[]};
bs[] = {s};
ex[] = Extrude {0, 0, 100} { Surface{bs[]}; };
s4[] = {ex[1]};
