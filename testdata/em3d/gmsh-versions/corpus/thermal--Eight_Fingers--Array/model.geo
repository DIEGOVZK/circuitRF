Line(l + 3) = {p + 3, p + 0};
c = newcl; Curve Loop(c) = {l:l + 3};
cl[] += {c};
s = news; Plane Surface(s) = {cl[]};
h1[] = {s};
// source f3
cl[] = {};
p = newp;
Point(p + 0) = {-65, 0, 0};
Point(p + 1) = {-55, 0, 0};
