Field[18] = Threshold; Field[18].InField = 17; Field[18].SizeMin = 2.5; Field[18].SizeMax = 100; Field[18].DistMin = 2.5; Field[18].DistMax = 327.5;
Field[19] = Min; Field[19].FieldsList = {1, 2, 4, 6, 8, 10, 12, 14, 16, 18};
Background Field = 19;
Mesh.ElementOrder = 2;
Mesh.HighOrderOptimize = 2;
Mesh.MshFileVersion = 2.2;
Mesh.Binary = 1;
