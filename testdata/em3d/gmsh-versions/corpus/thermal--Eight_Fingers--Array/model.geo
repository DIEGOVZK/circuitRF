Field[12] = Threshold; Field[12].InField = 11; Field[12].SizeMin = 2.5; Field[12].SizeMax = 100; Field[12].DistMin = 2.5; Field[12].DistMax = 327.5;
Field[13] = Distance; Field[13].SurfacesList = {w5[]}; Field[13].Sampling = 50;
Field[14] = Threshold; Field[14].InField = 13; Field[14].SizeMin = 2.5; Field[14].SizeMax = 100; Field[14].DistMin = 2.5; Field[14].DistMax = 327.5;
Field[15] = Distance; Field[15].SurfacesList = {w6[]}; Field[15].Sampling = 50;
Field[16] = Threshold; Field[16].InField = 15; Field[16].SizeMin = 2.5; Field[16].SizeMax = 100; Field[16].DistMin = 2.5; Field[16].DistMax = 327.5;
