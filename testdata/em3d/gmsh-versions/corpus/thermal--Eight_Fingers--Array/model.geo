Point(p + 0) = {135, 0, 0};
Point(p + 1) = {145, 0, 0};
Point(p + 2) = {145, 100, 0};
Point(p + 3) = {135, 100, 0};
l = newc;
Line(l + 0) = {p + 0, p + 1};
Line(l + 1) = {p + 1, p + 2};
Line(l + 2) = {p + 2, p + 3};
Line(l + 3) = {p + 3, p + 0};
c = newcl; Curve Loop(c) = {l:l + 3};
cl[] += {c};
s = news; Plane Surface(s) = {cl[]};
h7[] = {s};

// ---- one fragment: imprints the shared faces and the sheets, splits no volume -------------
frag[] = BooleanFragments{ Volume{s0[], s1[]}; Delete; }{ Surface{h0[], h1[], h2[], h3[], h4[], h5[], h6[], h7[]}; Delete; };
allV[] = Volume{:};
allS[] = Surface{:};
single[] = CombinedBoundary{ Volume{allV[]}; };
For k In {0:#single[]-1}
  single[k] = Abs(single[k]);
EndFor
claimed[] = {};

// ---- surfaces, recovered by what circuitRF placed ------------------------------------------
// source f1
w0[] = Surface In BoundingBox{-145 - e, 0 - e, 0 - e, -135 + e, 100 + e, 0 + e};
// source f2
w1[] = Surface In BoundingBox{-105 - e, 0 - e, 0 - e, -95 + e, 100 + e, 0 + e};
// source f3
w2[] = Surface In BoundingBox{-65 - e, 0 - e, 0 - e, -55 + e, 100 + e, 0 + e};
// source f4
w3[] = Surface In BoundingBox{-25 - e, 0 - e, 0 - e, -15 + e, 100 + e, 0 + e};
// source f5
w4[] = Surface In BoundingBox{15 - e, 0 - e, 0 - e, 25 + e, 100 + e, 0 + e};
// source f6
w5[] = Surface In BoundingBox{55 - e, 0 - e, 0 - e, 65 + e, 100 + e, 0 + e};
// source f7
w6[] = Surface In BoundingBox{95 - e, 0 - e, 0 - e, 105 + e, 100 + e, 0 + e};
// source f8
w7[] = Surface In BoundingBox{135 - e, 0 - e, 0 - e, 145 + e, 100 + e, 0 + e};
// face carrier/zmin: its exterior surfaces only (a boundary condition)
f0[] = Surface In BoundingBox{-500 - e, 0 - e, -600 - e, 500 + e, 500 + e, -600 + e};
own[] = Abs(Boundary{ Volume{s1[]}; });
x[] = f0[];
x[] -= own[];
f0[] -= x[];
x[] = f0[];
x[] -= single[];
f0[] -= x[];
claimed[] += f0[];

// ---- physical groups: the solver's tags (groups.json) ---------------------------------------
Physical Volume("substrate", 1) = {s0[]};
Physical Volume("carrier", 2) = {s1[]};
Physical Surface("f1", 3) = {w0[]};
Physical Surface("f2", 4) = {w1[]};
Physical Surface("f3", 5) = {w2[]};
Physical Surface("f4", 6) = {w3[]};
Physical Surface("f5", 7) = {w4[]};
Physical Surface("f6", 8) = {w5[]};
Physical Surface("f7", 9) = {w6[]};
Physical Surface("f8", 10) = {w7[]};
Physical Surface("carrier/zmin", 11) = {f0[]};

// ---- the entity table circuitRF checks before it believes this mesh ----------------------
Printf("# circuitRF entity table: group <attribute> <count> <volume tags lost in the fragment>") > "entities.txt";
lost[] = s0[];
lost[] -= allV[];
Printf("group 1 %g %g", #s0[], #lost[]) >> "entities.txt";
lost[] = s1[];
lost[] -= allV[];
Printf("group 2 %g %g", #s1[], #lost[]) >> "entities.txt";
Printf("group 3 %g 0", #w0[]) >> "entities.txt";
Printf("group 4 %g 0", #w1[]) >> "entities.txt";
Printf("group 5 %g 0", #w2[]) >> "entities.txt";
Printf("group 6 %g 0", #w3[]) >> "entities.txt";
Printf("group 7 %g 0", #w4[]) >> "entities.txt";
Printf("group 8 %g 0", #w5[]) >> "entities.txt";
Printf("group 9 %g 0", #w6[]) >> "entities.txt";
Printf("group 10 %g 0", #w7[]) >> "entities.txt";
Printf("group 11 %g 0", #f0[]) >> "entities.txt";
Printf("all_volumes %g", #allV[]) >> "entities.txt";
Printf("classified_volumes %g", #s0[] + #s1[]) >> "entities.txt";
Printf("all_surfaces %g", #allS[]) >> "entities.txt";
Printf("single_sided %g", #single[]) >> "entities.txt";
// an unnamed single-sided surface is insulated in a thermal run, by definition
Printf("unclassified_single_sided 0") >> "entities.txt";

// ---- sizing: no wavelength -------------------------------------------------------------------
// Largest element 0.1 of the problem's largest side; at least 2 element(s) through each solid; 4 across each heat source's smaller side; growing by 1.3.
Mesh.MeshSizeMax = 100;
Mesh.MeshSizeFromPoints = 0;
Mesh.MeshSizeExtendFromBoundary = 0;
Mesh.MeshSizeFromCurvature = 12;
Field[1] = Constant; Field[1].VIn = 50; Field[1].VolumesList = {s0[]};
Field[2] = Constant; Field[2].VIn = 100; Field[2].VolumesList = {s1[]};
Field[3] = Distance; Field[3].SurfacesList = {w0[]}; Field[3].Sampling = 50;
Field[4] = Threshold; Field[4].InField = 3; Field[4].SizeMin = 2.5; Field[4].SizeMax = 100; Field[4].DistMin = 2.5; Field[4].DistMax = 327.5;
Field[5] = Distance; Field[5].SurfacesList = {w1[]}; Field[5].Sampling = 50;
