<!-- The Model Validation Report dialog (brief-modelcomposer-15 R-mc15-7a): every option of the report, each opening on the
     value stored in the .cmc or its default; Apply writes them back, Generate runs the report off the UI thread with the
     window's progress and Cancel, Export PDF draws every tab of its Data Display document. -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="using:CircuitRF.Ui.ModelComposer"
        x:Class="CircuitRF.Ui.Views.ModelComposer.ModelReportDialog"
        x:DataType="mc:ModelReportViewModel"
        Title="Model Validation Report"
        Width="560" Height="640" MinWidth="480" MinHeight="520"
        WindowStartupLocation="CenterOwner">
    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.lbl">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource SystemBaseMediumColor}"/>
        </Style>
        <Style Selector="TextBlock.hdr">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,6,0,2"/>
        </Style>
        <Style Selector="TextBlock.warn">
            <Setter Property="Foreground" Value="{DynamicResource CrfWarningBrush}"/>
        </Style>
        <Style Selector="TextBox">
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
        </Style>
    </Window.Styles>

    <DockPanel Margin="12" Background="{DynamicResource SystemChromeMediumLowColor}">
        <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding Owner.IsRunning}">
                <TextBlock Classes="lbl" Text="{Binding Owner.TaskStage}" MaxWidth="260" TextTrimming="CharacterEllipsis"/>
                <ProgressBar Width="160" Minimum="0" Maximum="1" Value="{Binding Owner.Progress}"
                             IsIndeterminate="{Binding !Owner.ProgressKnown}" VerticalAlignment="Center"/>
                <Button Content="Cancel" Command="{Binding Owner.CancelCommand}"/>
            </StackPanel>
            <TextBlock Classes="warn" Text="{Binding Problem}" TextWrapping="Wrap"
                       IsVisible="{Binding Problem, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            <TextBlock Text="{Binding Owner.StatusText}" TextWrapping="Wrap" FontSize="11"/>
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                <Button Content="Apply" Command="{Binding ApplyOptionsCommand}"/>
                <Button Content="Generate" Command="{Binding GenerateCommand}"/>
                <Button Content="Export PDF…" Command="{Binding ExportPdfCommand}"/>
                <Button Name="CloseButton" Content="Close"/>
            </StackPanel>
        </StackPanel>

        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="3">
                <TextBlock Classes="hdr" Text="Sections"/>
                <WrapPanel>
                    <CheckBox Content="DC I–V" IsChecked="{Binding Dc}" Margin="0,0,12,0"/>
                    <CheckBox Content="Thermal" IsChecked="{Binding Thermal}" Margin="0,0,12,0"/>
                    <CheckBox Content="Charge" IsChecked="{Binding Charge}" Margin="0,0,12,0"/>
                    <CheckBox Content="C–V" IsChecked="{Binding CapacitanceSlices}" Margin="0,0,12,0"/>
                    <CheckBox Content="S" IsChecked="{Binding SParams}" Margin="0,0,12,0"/>
                    <CheckBox Content="PA classes" IsChecked="{Binding PaModes}"/>
                </WrapPanel>

                <TextBlock Classes="hdr" Text="S and C–V"/>
                <Grid ColumnDefinitions="160,*">
                    <TextBlock Classes="lbl" Text="S biases (vgs, vds; …)"/>
                    <TextBox Grid.Column="1" Text="{Binding SBiases}" Watermark="lowest, middle and highest current"/>
                </Grid>
                <Grid ColumnDefinitions="160,*">
                    <TextBlock Classes="lbl" Text="C–V at Vds (V)"/>
                    <TextBox Grid.Column="1" Text="{Binding FixedVds}" Watermark="five spread over the data"/>
                </Grid>
                <Grid ColumnDefinitions="160,*">
                    <TextBlock Classes="lbl" Text="C–V at Vgs (V)"/>
                    <TextBox Grid.Column="1" Text="{Binding FixedVgs}" Watermark="five spread over the data"/>
                </Grid>

                <TextBlock Classes="hdr" Text="PA classes"/>
                <WrapPanel>
                    <CheckBox Content="B" IsChecked="{Binding ClassB}" Margin="0,0,12,0"/>
                    <CheckBox Content="J" IsChecked="{Binding ClassJ}" Margin="0,0,12,0"/>
                    <CheckBox Content="J*" IsChecked="{Binding ClassJStar}" Margin="0,0,12,0"/>
                    <CheckBox Content="F" IsChecked="{Binding ClassF}" Margin="0,0,12,0"/>
                    <CheckBox Content="F⁻¹" IsChecked="{Binding ClassFInverse}"/>
                </WrapPanel>
                <Grid ColumnDefinitions="160,*">
                    <TextBlock Classes="lbl" Text="Frequency (GHz)"/>
                    <TextBox Grid.Column="1" Text="{Binding FrequencyGHz}" Watermark="the data's"/>
                </Grid>
                <Grid ColumnDefinitions="160,*,*">
                    <TextBlock Classes="lbl" Text="Bias Vgs, Vds (V)"/>
                    <TextBox Grid.Column="1" Text="{Binding Vgs}" Watermark="Class B"/>
                    <TextBox Grid.Column="2" Text="{Binding Vds}" Margin="4,0,0,0" Watermark="the data's"/>
                </Grid>
                <Grid ColumnDefinitions="160,*">
                    <TextBlock Classes="lbl" Text="R_opt (Ω)"/>
                    <TextBox Grid.Column="1" Text="{Binding Ropt}" Watermark="from the knee"/>
                </Grid>
                <Grid ColumnDefinitions="160,*">
                    <TextBlock Classes="lbl" Text="Source Z (re, im Ω)"/>
                    <TextBox Grid.Column="1" Text="{Binding SourceZ}" Watermark="conjugate match"/>
                </Grid>
                <Grid ColumnDefinitions="160,*">
                    <TextBlock Classes="lbl" Text="Source 2f0 (re, im Ω)"/>
                    <TextBox Grid.Column="1" Text="{Binding Source2f0}" Watermark="short"/>
                </Grid>

                <TextBlock Classes="hdr" Text="Load disc and drive"/>
                <Grid ColumnDefinitions="160,*,*,*">
                    <TextBlock Classes="lbl" Text="Radius, rings, spokes"/>
                    <TextBox Grid.Column="1" Text="{Binding GammaRadius}"/>
                    <TextBox Grid.Column="2" Text="{Binding Rings}" Margin="4,0,0,0"/>
                    <TextBox Grid.Column="3" Text="{Binding Spokes}" Margin="4,0,0,0"/>
                </Grid>
                <Grid ColumnDefinitions="160,*,*,*">
                    <TextBlock Classes="lbl" Text="Drive start, step, max (dBm)"/>
                    <TextBox Grid.Column="1" Text="{Binding PinStart}"/>
                    <TextBox Grid.Column="2" Text="{Binding PinStep}" Margin="4,0,0,0"/>
                    <TextBox Grid.Column="3" Text="{Binding PinMax}" Margin="4,0,0,0"/>
                </Grid>
                <Grid ColumnDefinitions="160,*">
                    <TextBlock Classes="lbl" Text="Compression (dB)"/>
                    <TextBox Grid.Column="1" Text="{Binding Compression}"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
