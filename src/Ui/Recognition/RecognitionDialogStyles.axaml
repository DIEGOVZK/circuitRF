<!-- The Create … from … dialog's styles (brief-img-5-dialog.md R-im5-1), shared by the window and the controls it is
     built from — RecognitionTargetRow, RecognitionOptionsRow, PartsTablePanel, RecognitionReportStrip, ImageSourcePane
     and ImageReadingPanel — so a row looks the same whichever source sits above it. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mi="using:Material.Icons.Avalonia"
        xmlns:ctrl="using:CircuitRF.Ui.Controls">

    <Style Selector="TextBox.invalid">
        <Setter Property="BorderBrush" Value="#C8463A"/>
    </Style>
    <Style Selector="TextBlock.label">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Opacity" Value="0.8"/>
    </Style>
    <!-- A refusal is copied out as often as it is read (R-ptu1-3): most are SelectableTextBlocks, which a TextBlock
         selector does not reach. -->
    <Style Selector="TextBlock.error, SelectableTextBlock.error">
        <Setter Property="Foreground" Value="#C8463A"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <!-- A row of mixed controls centres every one of them on the row: left to stretch, a text box grows to the
         tallest neighbour and a combo sits on the top edge, so no two baselines agree. -->
    <Style Selector="WrapPanel.row > :is(Control), StackPanel.row > :is(Control)">
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <!-- The parts table's editors: one height, their text centred in it. -->
    <Style Selector="Grid.cells > TextBox, Grid.cells > Panel > TextBox">
        <Setter Property="Height" Value="24"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Padding" Value="4,0"/>
        <Setter Property="Margin" Value="0,0,4,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Grid.cells > ComboBox">
        <Setter Property="Height" Value="24"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Padding" Value="6,0,0,0"/>
        <Setter Property="Margin" Value="0,0,4,0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.header">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="2,1"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>

    <!-- A choice in a toolbar (brief-ptu-2 R-ptu2-1): a radio button drawn as a toolbar toggle — flat while unchecked,
         the theme's checked fill when chosen. ToggleButton.PanelToggle's treatment, restated for RadioButton because a
         type selector matches its type exactly. The flat background is a STYLE value, never a local one: a local value
         would beat the theme's :checked fill and the choice would never look chosen. -->
    <Style Selector="RadioButton.tool">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="6,3"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="RadioButton.tool:checked mi|MaterialIcon">
        <Setter Property="Foreground" Value="{DynamicResource ToggleButtonForegroundChecked}"/>
    </Style>
    <!-- The custom glyphs take the toolbar's icon grey, and the checked foreground when chosen, as the icons do. -->
    <Style Selector="StackPanel.Toolbar ctrl|ImageMakeGlyphControl">
        <Setter Property="Stroke" Value="{DynamicResource SystemBaseMediumColor}"/>
    </Style>
    <Style Selector="RadioButton.tool:checked ctrl|ImageMakeGlyphControl">
        <Setter Property="Stroke" Value="{DynamicResource ToggleButtonForegroundChecked}"/>
    </Style>
    <Style Selector="RadioButton.tool:disabled">
        <Setter Property="Opacity" Value="0.45"/>
    </Style>
    <!-- The editors' toolbar separator, sized for a row whose children are centred rather than stretched. -->
    <Style Selector="Border.sep">
        <Setter Property="Width" Value="1"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Margin" Value="10,0"/>
        <Setter Property="Background" Value="{DynamicResource SystemControlForegroundBaseLowBrush}"/>
    </Style>

    <!-- A slot around a control that may be the one the reading is waiting for (R-im5-4, R-im5-8): its border is
         always there, transparent, so highlighting it moves nothing. -->
    <Style Selector="Border.slot">
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="4,2"/>
    </Style>
    <Style Selector="Border.slot.wants">
        <Setter Property="BorderBrush" Value="#D9A21B"/>
        <Setter Property="Background" Value="#22D9A21B"/>
    </Style>

    <!-- A link that is a button. -->
    <Style Selector="Button.link">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="2,0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.link /template/ ContentPresenter">
        <Setter Property="TextBlock.TextDecorations" Value="Underline"/>
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
</Styles>
