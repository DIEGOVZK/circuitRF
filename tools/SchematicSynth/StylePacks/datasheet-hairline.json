{
  "name": "datasheet-hairline",
  "about": "A data sheet's application circuit: a hairline pen, small sans words (bold now and then), an IC box with numbered pins outside and named pins inside, curved-plate capacitors, filled dots, open-circle terminals, supply arrows, hops where wires cross, notes, dimension arrows and a dashed fixture frame.",
  "families": ["corpus-ds"],
  "medium": "document",
  "weight": 1.2,
  "palettes": [
    { "paper": "#ffffff", "grid": "#ffffff", "wire": "#000000", "symbol": "#000000", "text": ["#000000"], "type": "#000000", "fill": "#e0e0e0", "accent": "#000000" },
    { "paper": "#ffffff", "grid": "#ffffff", "wire": "#1a1a8a", "symbol": "#1a1a8a", "text": ["#1a1a8a", "#000000"], "type": "#1a1a8a", "fill": "#fff7b0", "accent": "#c00000" }
  ],
  "canvas": { "grid": "none", "frame": 0.05, "titleBlock": 0.5 },
  "pens": { "wire": [0.004, 0.009], "symbol": [0.004, 0.009], "minPx": [1, 1.3], "caps": "butt", "antialias": 0.95, "symbolScale": [0.75, 0.95] },
  "text": {
    "fonts": { "sans": 4, "condensed": 1, "ui": 1 }, "size": [0.45, 0.65], "bold": 0.25,
    "stacks": [ { "lines": ["designator", "value"], "weight": 4 }, { "lines": ["designator", "value"], "row": true, "weight": 1 } ],
    "placement": { "side": 3, "above": 1 }, "rotated": 0.15,
    "valueForms": { "bare": 3, "spice": 2, "letter": 1 }, "ohm": { "Ω": 3, "": 1 }, "micro": { "µ": 2, "u": 1 },
    "netLabels": { "text": 2, "power-port": 2, "terminal": 2 }
  },
  "junctions": { "dots": { "circle": 1 }, "size": [0.06, 0.1], "pinMarkers": "none", "hops": 0.3 },
  "glyphs": {
    "resistor": ["resistor.plain*3", "resistor.zigzag-short", "resistor.variable"],
    "capacitor": ["capacitor.plain*2", "capacitor.curved*2", "capacitor.wide-gap"],
    "capacitor-polarised": ["capacitor-polarised.curved*2", "capacitor-polarised.plain"],
    "inductor": ["inductor.plain*2", "inductor.bumps-3", "inductor.core"],
    "ground": ["ground.plain*3", "ground.triangle-filled", "ground.chassis"],
    "terminal": ["terminal.plain*3", "terminal.circle-filled", "terminal.circle-dot"],
    "power-port": ["power-port.plain*2", "power-port.bar", "power-port.circle"],
    "port": ["port.box"],
    "source-dc": ["source-dc.plain", "source-dc.circle-pm"],
    "source-ac": ["source-ac.plain"],
    "source-current": ["source-current.plain"],
    "diode": ["diode.filled*2", "diode.schottky", "diode.zener", "diode.varactor", "diode.led"],
    "bjt-npn": ["bjt-npn.plain"],
    "bjt-pnp": ["bjt-pnp.plain"],
    "fet-n": ["fet-n.plain"],
    "fet-p": ["fet-p.plain"],
    "amplifier": ["amplifier.filled", "amplifier.plain"],
    "op-amp": ["op-amp.plain", "op-amp.marks"],
    "ic-box": ["ic-box.plain*2", "ic-box.notch", "ic-box.pin1-dot", "ic-box.filled"],
    "block": ["block.plain"],
    "transformer": ["transformer.plain", "transformer.no-core"],
    "stub-short": ["stub-short.end-bar"],
    "via": ["via.plain"],
    "switch-spdt": ["switch-spdt.no-dots"],
    "balun": ["balun.coils"],
    "probe": ["probe.flag", "probe.circle-arrow"],
    "no-connect": ["no-connect.plain*2", "no-connect.small"]
  },
  "substitute": { "ic-box": 0.8, "op-amp": 0.15, "capacitor-polarised": 0.2, "stub-short": 1 },
  "distractors": { "note": 0.35, "arrows": 0.3, "frame": 0.15, "dut": 0.1, "title": 0.1, "caption": 0.25, "probe": 0.04, "twoCircuits": 0.05 }
}
