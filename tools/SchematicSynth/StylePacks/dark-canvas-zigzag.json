{
  "name": "dark-canvas-zigzag",
  "about": "A dark editor theme: a near-black or slate canvas, wires in green, yellow or cyan, symbols in pale grey or red, light words, zig-zag resistors and bumped coils, round dots, a faint dot or line grid, dark window chrome.",
  "families": ["family-b", "family-c"],
  "medium": "screen",
  "weight": 0.9,
  "palettes": [
    { "paper": "#1e1e1e", "grid": "#3a3a3a", "wire": "#4ec94e", "symbol": "#d0d0d0", "text": ["#e0e0e0", "#9cdcfe"], "type": "#9cdcfe", "fill": "#404040", "accent": "#f0c040" },
    { "paper": "#000000", "grid": "#303030", "wire": "#00c000", "symbol": "#ff4040", "text": ["#e0e0e0"], "type": "#c0c0c0", "fill": "#402020", "accent": "#ffff40" },
    { "paper": "#2b3038", "grid": "#424852", "wire": "#e8d44d", "symbol": "#c8ccd4", "text": ["#f0f0f0", "#60d0ff"], "type": "#60d0ff", "fill": "#3a4250", "accent": "#ff8060" },
    { "paper": "#202830", "grid": "#34404c", "wire": "#40d0d0", "symbol": "#f0f0f0", "text": ["#f0f0a0"], "type": "#f0f0a0", "fill": "#304050", "accent": "#ff6060" }
  ],
  "canvas": { "grid": { "dots": 0.5, "lines": 0.2, "none": 0.3 }, "gridPitch": [0.5, 1] },
  "pens": { "wire": [0.006, 0.014], "symbol": [0.006, 0.014], "minPx": [1, 2], "caps": "round", "antialias": 0.9, "symbolScale": [0.8, 1] },
  "text": {
    "fonts": { "sans": 2, "mono": 2, "ui": 1 }, "size": [0.5, 0.8],
    "stacks": [ { "lines": ["designator", "value"], "weight": 3 }, { "lines": ["type", "designator", "values"], "weight": 1 } ],
    "placement": "side",
    "valueForms": { "spice": 2, "bare": 2, "named": 1 }, "ohm": { "Ω": 2, "Ohm": 1 }, "micro": { "µ": 1, "u": 1 },
    "netLabels": { "text": 3, "power-port": 1, "terminal": 1 }
  },
  "junctions": { "dots": { "circle": 3, "square": 1 }, "size": [0.08, 0.14], "pinMarkers": { "none": 3, "circle": 1 }, "hops": 0.05 },
  "glyphs": {
    "resistor": ["resistor.plain*3", "resistor.zigzag-wide", "resistor.box"],
    "capacitor": ["capacitor.plain*2", "capacitor.curved"],
    "capacitor-polarised": ["capacitor-polarised.plain", "capacitor-polarised.curved"],
    "inductor": ["inductor.plain*2", "inductor.loops"],
    "ground": ["ground.plain*2", "ground.triangle"],
    "terminal": ["terminal.plain", "terminal.flag", "terminal.hexagon"],
    "power-port": ["power-port.bar", "power-port.plain", "power-port.triangle-up"],
    "port": ["port.circle-sine", "port.box"],
    "source-ac": ["source-ac.plain", "source-ac.circle-pm"],
    "source-dc": ["source-dc.plain", "source-dc.circle-pm"],
    "source-current": ["source-current.plain"],
    "diode": ["diode.plain", "diode.filled"],
    "bjt-npn": ["bjt-npn.plain", "bjt-npn.circle"],
    "bjt-pnp": ["bjt-pnp.plain"],
    "fet-n": ["fet-n.plain"],
    "fet-p": ["fet-p.plain"],
    "amplifier": ["amplifier.plain", "amplifier.small"],
    "op-amp": ["op-amp.marks"],
    "ic-box": ["ic-box.plain", "ic-box.pin1-dot"],
    "block": ["block.plain"],
    "tline": ["tline.plain"],
    "mlin": ["mlin.plain"],
    "stub-short": ["stub-short.plain"],
    "via": ["via.plain"],
    "probe": ["probe.flag"],
    "controller": ["controller.plain"],
    "no-connect": ["no-connect.plain"]
  },
  "substitute": { "capacitor-polarised": 0.1, "ic-box": 0.3, "op-amp": 0.2, "stub-short": 1 },
  "distractors": { "controller": 0.15, "directive": 0.15, "title": 0.08, "frame": 0.08, "probe": 0.05, "cursor": 0.1, "selection": 0.08, "chrome": 0.6, "twoCircuits": 0.03 },
  "controllerTitles": ["DC", "AC", "TRANSIENT", "S-PARAMETERS"]
}
