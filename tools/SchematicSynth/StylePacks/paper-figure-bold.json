{
  "name": "paper-figure-bold",
  "about": "A conference figure: a heavy black pen, bold sans words, box lines and amplifier triangles in block diagrams, circulators, filled junction dots, resistances written 25Ω, Z with subscripts, a serif caption under it.",
  "families": ["family-e"],
  "medium": "paper",
  "weight": 1,
  "palettes": [
    { "paper": "#ffffff", "grid": "#ffffff", "wire": "#000000", "symbol": "#000000", "text": ["#000000"], "type": "#000000", "fill": "#bfbfbf", "accent": "#000000" },
    { "paper": "#ffffff", "grid": "#ffffff", "wire": "#202020", "symbol": "#202020", "text": ["#202020", "#1f4e9c"], "type": "#202020", "fill": "#d0d0d0", "accent": "#1f4e9c" }
  ],
  "canvas": { "grid": "none" },
  "pens": { "wire": [0.035, 0.07], "symbol": [0.035, 0.07], "minPx": [1.5, 3], "caps": "square", "antialias": 0.95, "symbolScale": [0.75, 0.95] },
  "text": {
    "fonts": { "sans-bold": 3, "condensed-bold": 1, "serif-bold": 1 }, "size": [0.8, 1.2],
    "stacks": [ { "lines": ["designator"], "weight": 2 }, { "lines": ["value"], "weight": 2 }, { "lines": ["designator", "value"], "weight": 2 } ],
    "placement": { "side": 1, "above": 2 },
    "valueForms": { "bare": 3, "spice": 1 }, "ohm": { "Ω": 1 }, "micro": { "µ": 1 }, "subscripts": 0.5,
    "netLabels": { "text": 3, "terminal": 2 }
  },
  "junctions": { "dots": { "circle": 1 }, "size": [0.14, 0.22], "pinMarkers": "none", "hops": 0 },
  "glyphs": {
    "resistor": ["resistor.plain*2", "resistor.box"],
    "capacitor": ["capacitor.thick*2", "capacitor.plain"],
    "capacitor-polarised": ["capacitor-polarised.curved"],
    "inductor": ["inductor.plain*2", "inductor.bumps-3", "inductor.core"],
    "ground": ["ground.plain*2", "ground.bars-tall"],
    "terminal": ["terminal.plain*3", "terminal.circle-filled"],
    "power-port": ["power-port.circle", "power-port.plain"],
    "port": ["port.circle-sine"],
    "source-ac": ["source-ac.plain"],
    "source-dc": ["source-dc.plain"],
    "source-current": ["source-current.plain"],
    "diode": ["diode.filled"],
    "bjt-npn": ["bjt-npn.circle"],
    "fet-n": ["fet-n.circle*2", "fet-n.plain"],
    "fet-p": ["fet-p.circle"],
    "amplifier": ["amplifier.plain*3", "amplifier.small"],
    "block": ["block.plain"],
    "tline": ["tline.slim*2", "tline.plain"],
    "mlin": ["mlin.thin"],
    "transformer": ["transformer.plain", "transformer.loops"],
    "attenuator": ["attenuator.plain"],
    "filter": ["filter.plain", "filter.two-wave"],
    "circulator": ["circulator.plain*2", "circulator.y"],
    "coupler": ["coupler.box-arrow", "coupler.lines"],
    "balun": ["balun.coils", "balun.box-b"],
    "mixer": ["mixer.plain", "mixer.small-x"],
    "switch": ["switch.no-dots"],
    "switch-spdt": ["switch-spdt.no-dots"]
  },
  "substitute": {},
  "distractors": { "caption": 0.7, "title": 0.15, "arrows": 0.15, "frame": 0.12, "twoCircuits": 0.3 }
}
