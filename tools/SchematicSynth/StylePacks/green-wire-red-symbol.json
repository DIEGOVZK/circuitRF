{
  "name": "green-wire-red-symbol",
  "about": "A board-design schematic editor: green wires with green junction dots, dark-red symbols with box resistors, teal monospaced words, designator over value, open-triangle grounds and supply flags, on ivory paper with a dotted grid and window chrome.",
  "families": ["family-b"],
  "medium": "screen",
  "weight": 1.2,
  "palettes": [
    { "paper": "#f5f4ef", "grid": "#a0a0a0", "wire": "#009600", "symbol": "#840000", "text": ["#006464", "#008484"], "type": "#006464", "fill": "#ffffc2", "accent": "#840000" },
    { "paper": "#ffffff", "grid": "#b0b0b0", "wire": "#008000", "symbol": "#a00000", "text": ["#007878"], "type": "#007878", "fill": "#ffffb0", "accent": "#a00000" },
    { "paper": "#202020", "grid": "#505050", "wire": "#30d030", "symbol": "#e05050", "text": ["#40c0c0"], "type": "#40c0c0", "fill": "#504020", "accent": "#e0e040" }
  ],
  "canvas": { "grid": { "dots": 0.8, "none": 0.2 }, "gridPitch": [0.5, 1], "frame": 0.1, "titleBlock": 0.6 },
  "pens": { "wire": [0.008, 0.016], "symbol": [0.01, 0.02], "minPx": [1.2, 2.2], "caps": "round", "antialias": 0.95, "symbolScale": [0.8, 0.95] },
  "text": {
    "fonts": { "mono": 3, "sans": 1 }, "size": [0.55, 0.85],
    "stacks": [ { "lines": ["designator", "value"], "weight": 4 }, { "lines": ["designator", "values"], "weight": 1 } ],
    "placement": "side",
    "valueForms": { "spice": 3, "bare": 1 }, "ohm": { "Ω": 1 }, "micro": { "u": 1 },
    "netLabels": { "text": 2, "power-port": 3, "terminal": 1 }
  },
  "junctions": { "dots": { "circle": 1 }, "size": [0.1, 0.16], "pinMarkers": "none", "hops": 0 },
  "glyphs": {
    "resistor": ["resistor.box*3", "resistor.box-slim"],
    "capacitor": ["capacitor.thick*2", "capacitor.plain"],
    "capacitor-polarised": ["capacitor-polarised.filled-plate*2", "capacitor-polarised.box-plate"],
    "inductor": ["inductor.plain*2", "inductor.bumps-3"],
    "ground": ["ground.triangle*3", "ground.plain"],
    "terminal": ["terminal.plain", "terminal.flag"],
    "power-port": ["power-port.circle*2", "power-port.open-arrow*2", "power-port.bar"],
    "port": ["port.box"],
    "source-dc": ["source-dc.circle-pm", "source-dc.plain"],
    "source-ac": ["source-ac.sine-marks", "source-ac.circle-pm"],
    "source-current": ["source-current.plain"],
    "diode": ["diode.plain*2", "diode.led", "diode.zener", "diode.schottky"],
    "bjt-npn": ["bjt-npn.circle*3", "bjt-npn.plain"],
    "bjt-pnp": ["bjt-pnp.circle"],
    "fet-n": ["fet-n.plain", "fet-n.circle"],
    "fet-p": ["fet-p.plain", "fet-p.circle"],
    "amplifier": ["amplifier.plain", "amplifier.small"],
    "op-amp": ["op-amp.marks*2", "op-amp.plain"],
    "ic-box": ["ic-box.filled*2", "ic-box.plain"],
    "block": ["block.filled", "block.plain"],
    "transformer": ["transformer.plain", "transformer.no-core"],
    "switch": ["switch.plain"],
    "switch-spdt": ["switch-spdt.plain"],
    "controller": ["controller.plain"],
    "no-connect": ["no-connect.plain*2", "no-connect.bold"]
  },
  "substitute": { "capacitor-polarised": 0.35, "ic-box": 0.7, "op-amp": 0.25, "stub-short": 0 },
  "distractors": { "controller": 0, "note": 0.08, "title": 0.05, "frame": 0.1, "cursor": 0.12, "selection": 0.06, "chrome": 0.7, "twoCircuits": 0.04 }
}
