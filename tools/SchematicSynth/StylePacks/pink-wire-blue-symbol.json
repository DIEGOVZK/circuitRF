{
  "name": "pink-wire-blue-symbol",
  "about": "An RF editor's canvas: magenta wires, dark-blue symbols, blue words in a type / name / parameter stack, small squares at pin ends, analysis blocks with an icon, a dotted grid on white, grey or pale paper.",
  "families": ["family-a"],
  "medium": "screen",
  "weight": 1.4,
  "palettes": [
    { "paper": "#ffffff", "grid": "#9090a0", "wire": "#d0007f", "symbol": "#00008b", "text": ["#0000c8", "#000080"], "type": "#3a7bff", "fill": "#c8d0ff", "accent": "#ff2020" },
    { "paper": "#ece8ec", "grid": "#808080", "wire": "#c00070", "symbol": "#000090", "text": ["#0000d0"], "type": "#4080ff", "fill": "#d0d8ff", "accent": "#e00000" },
    { "paper": "#e6e6e6", "grid": "#707070", "wire": "#e0009a", "symbol": "#101070", "text": ["#000000", "#0000c0"], "type": "#3070f0", "fill": "#c0c8f0", "accent": "#ff0000" }
  ],
  "canvas": { "grid": { "dots": 0.7, "none": 0.3 }, "gridPitch": [0.5, 1] },
  "pens": { "wire": [0.004, 0.009], "symbol": [0.004, 0.009], "minPx": [1, 1.6], "caps": "butt", "antialias": 0.6, "symbolScale": [0.8, 0.95] },
  "text": {
    "fonts": { "sans": 3, "ui": 1, "condensed": 1 }, "size": [0.45, 0.7],
    "stacks": [ { "lines": ["type", "designator", "values"], "weight": 4 }, { "lines": ["designator", "values"], "weight": 1 } ],
    "placement": { "side": 3, "above": 1 },
    "valueForms": { "named": 1 }, "spaced": 0.05, "ohm": { "Ohm": 1 }, "micro": { "u": 1 }, "tags": 0.3,
    "netLabels": { "text": 6, "terminal": 1, "power-port": 1 }
  },
  "junctions": { "dots": { "none": 2, "square": 1 }, "size": [0.07, 0.1], "pinMarkers": { "square": 3, "filled-square": 1 }, "hops": 0 },
  "glyphs": {
    "resistor": ["resistor.zigzag-short*3", "resistor.plain"],
    "capacitor": ["capacitor.plain*2", "capacitor.narrow"],
    "capacitor-polarised": ["capacitor-polarised.plain"],
    "inductor": ["inductor.loops*3", "inductor.bumps-3"],
    "ground": ["ground.bars-equal*2", "ground.plain"],
    "terminal": ["terminal.hexagon*2", "terminal.circle-filled"],
    "power-port": ["power-port.bar", "power-port.plain"],
    "port": ["port.plain*2", "port.box-plus*2"],
    "source-ac": ["source-ac.plain*2", "source-ac.sine-marks"],
    "source-dc": ["source-dc.plain*3", "source-dc.battery-two"],
    "source-current": ["source-current.plain"],
    "diode": ["diode.filled*2", "diode.plain"],
    "bjt-npn": ["bjt-npn.plain"],
    "bjt-pnp": ["bjt-pnp.plain"],
    "fet-n": ["fet-n.mesfet*2", "fet-n.plain"],
    "fet-p": ["fet-p.mesfet", "fet-p.plain"],
    "amplifier": ["amplifier.plain"],
    "block": ["block.plain*3", "block.double"],
    "ic-box": ["ic-box.plain"],
    "tline": ["tline.plain*2", "tline.slim"],
    "mlin": ["mlin.plain*3", "mlin.thin"],
    "mtee": ["mtee.plain"],
    "mcross": ["mcross.plain"],
    "mbend": ["mbend.plain*2", "mbend.mitre"],
    "mstep": ["mstep.plain"],
    "stub-open": ["stub-open.plain"],
    "stub-short": ["stub-short.plain"],
    "via": ["via.box-x", "via.plain"],
    "attenuator": ["attenuator.plain"],
    "filter": ["filter.plain"],
    "switch": ["switch.box", "switch.plain"],
    "switch-spdt": ["switch-spdt.box"],
    "coupler": ["coupler.plain"],
