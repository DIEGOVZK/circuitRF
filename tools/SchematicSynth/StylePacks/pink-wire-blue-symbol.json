  "substitute": { "ic-box": 0.1, "stub-short": 1, "capacitor-polarised": 0 },
  "distractors": { "controller": 0.75, "directive": 0, "title": 0.04, "caption": 0, "note": 0.05, "frame": 0.12, "dut": 0.03, "arrows": 0.03, "probe": 0.15, "ring": 0.06, "cursor": 0.08, "selection": 0.04, "twoCircuits": 0.04, "chrome": 0.25 },
