{
  "name": "mono-grid-lines",
  "about": "Graph-paper drafting: a line grid on white or pale blue, black symbols, blue or black wires, monospaced upper-case words, designator and value on one line, IEC or zig-zag resistors, square pin markers, page border with a title block.",
  "families": ["family-b", "corpus-web"],
  "medium": "screen",
  "weight": 0.7,
  "palettes": [
    { "paper": "#ffffff", "grid": "#b8c8e0", "wire": "#1040a0", "symbol": "#000000", "text": ["#000000"], "type": "#000000", "fill": "#e8e8e8", "accent": "#c00000" },
    { "paper": "#f0f6ff", "grid": "#a8c0e0", "wire": "#000000", "symbol": "#000000", "text": ["#000000", "#203070"], "type": "#203070", "fill": "#dde4f0", "accent": "#d04000" }
  ],
  "canvas": { "grid": { "lines": 0.8, "dots": 0.2 }, "gridPitch": [0.5, 1], "frame": 0.4, "titleBlock": 0.7 },
  "pens": { "wire": [0.008, 0.02], "symbol": [0.008, 0.02], "minPx": [1, 2], "caps": "square", "antialias": 0.7, "symbolScale": [0.8, 1] },
  "text": {
    "fonts": { "mono": 3, "mono-bold": 1, "condensed": 1 }, "size": [0.5, 0.75],
    "stacks": [ { "lines": ["designator", "value"], "row": true, "weight": 3 }, { "lines": ["designator", "value"], "weight": 2 } ],
    "placement": { "above": 2, "side": 1 },
    "valueForms": { "letter": 1, "spice": 2, "bare": 1 }, "ohm": { "": 1 }, "micro": { "u": 1 },
    "netLabels": { "text": 2, "terminal": 1, "power-port": 1 }
  },
  "junctions": { "dots": { "circle": 2, "square": 1 }, "size": [0.08, 0.14], "pinMarkers": { "square": 1, "none": 2 }, "hops": 0.2 },
  "glyphs": {
    "resistor": ["resistor.box*2", "resistor.plain"],
    "capacitor": ["capacitor.plain", "capacitor.thick"],
    "capacitor-polarised": ["capacitor-polarised.box-plate"],
    "inductor": ["inductor.bumps-3", "inductor.plain"],
    "ground": ["ground.plain", "ground.flat"],
    "terminal": ["terminal.plain", "terminal.square"],
    "power-port": ["power-port.bar", "power-port.open-arrow"],
    "source-ac": ["source-ac.sine-marks"],
    "source-dc": ["source-dc.battery-two", "source-dc.plain"],
    "source-current": ["source-current.open-arrow"],
    "diode": ["diode.plain"],
    "bjt-npn": ["bjt-npn.open-arrow"],
    "bjt-pnp": ["bjt-pnp.open-arrow"],
    "fet-n": ["fet-n.plain"],
    "op-amp": ["op-amp.marks"],
    "ic-box": ["ic-box.notch", "ic-box.plain"],
    "transformer": ["transformer.plain"],
    "switch": ["switch.plain"],
    "switch-spdt": ["switch-spdt.plain"],
    "no-connect": ["no-connect.bold"]
  },
  "substitute": { "capacitor-polarised": 0.2, "ic-box": 0.5, "op-amp": 0.3 },
  "distractors": { "note": 0.15, "title": 0.1, "frame": 0.1, "chrome": 0.3, "cursor": 0.06, "twoCircuits": 0.04 }
}
