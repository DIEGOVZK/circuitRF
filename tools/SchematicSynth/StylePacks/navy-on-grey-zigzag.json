{
  "name": "navy-on-grey-zigzag",
  "about": "A circuit simulator's grey canvas: thin navy wires and symbols, big zig-zag resistors and loopy coils, large open-triangle grounds, circle sources marked + and -, small filled squares where nets join, large bold black words, dot directives and blue bold titles.",
  "families": ["family-c"],
  "medium": "screen",
  "weight": 1.2,
  "palettes": [
    { "paper": "#c0c0c0", "grid": "#9a9a9a", "wire": "#000080", "symbol": "#000080", "text": ["#000000"], "type": "#000000", "fill": "#ffff99", "accent": "#0000ff" },
    { "paper": "#bcbcbc", "grid": "#909090", "wire": "#1010a0", "symbol": "#1010a0", "text": ["#000000"], "type": "#000000", "fill": "#ffffa0", "accent": "#0000e0" }
  ],
  "canvas": { "grid": { "none": 0.7, "dots": 0.3 }, "gridPitch": [1, 1] },
  "pens": { "wire": [0.004, 0.008], "symbol": [0.004, 0.008], "minPx": [1, 1.5], "caps": "butt", "antialias": 0.4, "symbolScale": [0.9, 1] },
  "text": {
    "fonts": { "sans-bold": 3, "ui-bold": 1 }, "size": [0.75, 1.4],
    "stacks": [ { "lines": ["designator", "value"], "weight": 5 } ],
    "placement": { "side": 2, "above": 1 }, "rotated": 0.05,
    "valueForms": { "spice": 5, "bare": 1 }, "ohm": { "": 1 }, "micro": { "µ": 2, "u": 1 },
    "netLabels": { "text": 3, "terminal": 1, "power-port": 1 }
  },
  "junctions": { "dots": { "square": 1 }, "size": [0.12, 0.2], "pinMarkers": "none", "hops": 0 },
  "glyphs": {
    "resistor": ["resistor.zigzag-long*3", "resistor.zigzag-wide"],
    "capacitor": ["capacitor.narrow*2", "capacitor.plain"],
    "capacitor-polarised": ["capacitor-polarised.box-plate"],
    "inductor": ["inductor.loops-big*3", "inductor.loops"],
    "ground": ["ground.triangle-big*3", "ground.triangle"],
    "terminal": ["terminal.flag*2", "terminal.arrow"],
    "power-port": ["power-port.triangle-up*3", "power-port.open-arrow"],
    "port": ["port.circle-sine"],
    "source-ac": ["source-ac.circle-pm*3", "source-ac.pulse"],
    "source-dc": ["source-dc.circle-pm*4", "source-dc.plain"],
    "source-current": ["source-current.open-arrow"],
    "diode": ["diode.plain"],
    "bjt-npn": ["bjt-npn.plain"],
    "bjt-pnp": ["bjt-pnp.plain"],
    "fet-n": ["fet-n.plain"],
    "fet-p": ["fet-p.plain"],
    "op-amp": ["op-amp.marks"],
    "ic-box": ["ic-box.filled", "ic-box.plain"],
    "block": ["block.plain"],
    "switch": ["switch.plain"],
    "transformer": ["transformer.loops"],
    "no-connect": ["no-connect.plain"]
  },
  "substitute": { "op-amp": 0.6, "ic-box": 0.3, "capacitor-polarised": 0.1 },
  "distractors": { "directive": 0.75, "title": 0.25, "note": 0.08, "frame": 0.06, "arrows": 0.03, "chrome": 0.3, "cursor": 0.04, "twoCircuits": 0.03 }
}
