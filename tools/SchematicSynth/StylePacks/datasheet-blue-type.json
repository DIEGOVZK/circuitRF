    "terminal": ["terminal.circle-dot*3", "terminal.plain"],
    "power-port": ["power-port.plain*2", "power-port.circle"],
    "source-dc": ["source-dc.plain"],
    "diode": ["diode.filled"],
    "amplifier": ["amplifier.filled*3", "amplifier.plain"],
    "op-amp": ["op-amp.filled"],
    "ic-box": ["ic-box.filled", "ic-box.plain"],
    "block": ["block.filled", "block.plain"],
    "attenuator": ["attenuator.plain"],
    "filter": ["filter.plain"],
    "coupler": ["coupler.box-arrow"],
    "mixer": ["mixer.plain"],
    "switch": ["switch.plain"],
    "switch-spdt": ["switch-spdt.plain"],
    "circulator": ["circulator.box"],
