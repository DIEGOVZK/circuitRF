  "families": ["corpus-ds", "corpus-web"],
  "medium": "document",
  "weight": 0.9,
  "palettes": [
    { "paper": "#ffffff", "grid": "#ffffff", "wire": "#000000", "symbol": "#000000", "text": ["#1f4e9c", "#2a62c0"], "type": "#1f4e9c", "fill": "#c8c8c8", "accent": "#1f4e9c" },
    { "paper": "#ffffff", "grid": "#ffffff", "wire": "#202020", "symbol": "#202020", "text": ["#0060b0"], "type": "#0060b0", "fill": "#d4d4d4", "accent": "#0060b0" }
  ],
  "canvas": { "grid": "none" },
