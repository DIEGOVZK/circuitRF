{
  "name": "textbook-serif",
  "about": "A figure in a book or paper: a heavier black pen that scales with the drawing, zig-zag resistors and bumped coils, open-circle terminals, serif italic designators with subscripts, Ω values, figure captions (a) and (b), now and then two circuits side by side, printed and scanned.",
  "families": ["family-e", "corpus-web"],
  "medium": "paper",
  "weight": 1.2,
  "palettes": [
    { "paper": "#ffffff", "grid": "#ffffff", "wire": "#000000", "symbol": "#000000", "text": ["#000000"], "type": "#000000", "fill": "#d0d0d0", "accent": "#000000" },
    { "paper": "#f7f4ec", "grid": "#f7f4ec", "wire": "#111111", "symbol": "#111111", "text": ["#111111"], "type": "#111111", "fill": "#cccccc", "accent": "#111111" }
  ],
  "canvas": { "grid": "none" },
  "pens": { "wire": [0.02, 0.05], "symbol": [0.02, 0.05], "minPx": [1, 2], "caps": "round", "antialias": 0.9, "symbolScale": [0.8, 1] },
  "text": {
    "fonts": { "serif-italic": 4, "serif": 2, "sans": 1 }, "size": [0.7, 1.1],
    "stacks": [ { "lines": ["designator"], "weight": 2 }, { "lines": ["designator", "value"], "weight": 3 }, { "lines": ["designator", "value"], "row": true, "weight": 1 } ],
    "placement": { "side": 2, "above": 2 },
    "valueForms": { "bare": 3, "letter": 1, "spice": 1 }, "ohm": { "Ω": 1 }, "micro": { "µ": 1 }, "subscripts": 0.6,
    "netLabels": { "text": 2, "terminal": 3 }
  },
  "junctions": { "dots": { "circle": 4, "diamond": 1 }, "size": [0.1, 0.18], "pinMarkers": "none", "hops": 0.3 },
  "glyphs": {
    "resistor": ["resistor.plain*3", "resistor.zigzag-wide*2", "resistor.box"],
    "capacitor": ["capacitor.plain*2", "capacitor.thick", "capacitor.curved"],
    "capacitor-polarised": ["capacitor-polarised.curved", "capacitor-polarised.plain"],
    "inductor": ["inductor.plain*3", "inductor.loops", "inductor.core"],
    "ground": ["ground.plain*3", "ground.chassis"],
    "terminal": ["terminal.plain*4", "terminal.circle-filled"],
    "power-port": ["power-port.circle", "power-port.bar"],
    "port": ["port.circle-sine"],
    "source-ac": ["source-ac.plain*2", "source-ac.sine-marks"],
    "source-dc": ["source-dc.plain*2", "source-dc.circle-pm"],
    "source-current": ["source-current.plain", "source-current.double-circle"],
    "diode": ["diode.filled", "diode.plain", "diode.varactor"],
    "bjt-npn": ["bjt-npn.circle", "bjt-npn.plain"],
    "bjt-pnp": ["bjt-pnp.circle", "bjt-pnp.plain"],
    "fet-n": ["fet-n.circle", "fet-n.plain"],
    "fet-p": ["fet-p.circle", "fet-p.plain"],
    "amplifier": ["amplifier.plain"],
    "op-amp": ["op-amp.marks"],
    "block": ["block.plain"],
    "tline": ["tline.two-line", "tline.plain"],
    "transformer": ["transformer.plain", "transformer.no-core"],
    "stub-open": ["stub-open.plain"],
    "stub-short": ["stub-short.plain"],
    "circulator": ["circulator.plain"],
    "switch": ["switch.plain"],
    "no-connect": ["no-connect.plain"]
  },
  "substitute": { "capacitor-polarised": 0.1, "op-amp": 0.2, "stub-short": 1 },
  "distractors": { "caption": 0.7, "title": 0.08, "note": 0.05, "arrows": 0.3, "frame": 0.08, "twoCircuits": 0.25 }
}
