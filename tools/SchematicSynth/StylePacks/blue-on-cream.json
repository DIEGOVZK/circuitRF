{
  "name": "blue-on-cream",
  "about": "A free RF simulator's cream canvas with a dot grid: dark-blue wires and symbols of a heavier pen, box resistors, thick-plate capacitors, ports as a sine circle under a small box, slanted microstrip pieces, black words with Ω, framed analysis and equation blocks, now and then a plot beside the drawing.",
  "families": ["family-d"],
  "medium": "screen",
  "weight": 1.3,
  "palettes": [
    { "paper": "#fffde8", "grid": "#9a9a8a", "wire": "#00007f", "symbol": "#00007f", "text": ["#000000"], "type": "#000000", "fill": "#e0e0e0", "accent": "#a000a0" },
    { "paper": "#fdf6d8", "grid": "#8a8a7a", "wire": "#000088", "symbol": "#000088", "text": ["#000000", "#00007f"], "type": "#000000", "fill": "#d8d8d8", "accent": "#e00000" },
    { "paper": "#ffffff", "grid": "#a0a0a0", "wire": "#000090", "symbol": "#000090", "text": ["#000000"], "type": "#000000", "fill": "#e8e8e8", "accent": "#0000c0" }
  ],
  "canvas": { "grid": { "dots": 0.85, "none": 0.15 }, "gridPitch": [0.5, 1] },
  "pens": { "wire": [0.012, 0.02], "symbol": [0.012, 0.022], "minPx": [1.5, 2.5], "caps": "square", "antialias": 0.95, "symbolScale": [0.8, 0.95] },
  "text": {
    "fonts": { "sans": 3, "ui": 1 }, "size": [0.55, 0.85],
    "stacks": [ { "lines": ["designator", "values"], "weight": 5 } ],
    "placement": "side",
    "valueForms": { "named": 4, "bare": 1 }, "spaced": 0, "ohm": { "Ω": 3, "Ohm": 1 }, "micro": { "u": 2, "µ": 1 },
    "netLabels": { "text": 3, "terminal": 1 }
  },
  "junctions": { "dots": { "circle": 1 }, "size": [0.06, 0.1], "pinMarkers": { "none": 3, "circle": 1 }, "hops": 0 },
  "glyphs": {
    "resistor": ["resistor.box*3", "resistor.box-long"],
    "capacitor": ["capacitor.thick*3", "capacitor.plain"],
    "inductor": ["inductor.plain*2", "inductor.bumps-3"],
    "ground": ["ground.bars-tall*2", "ground.plain"],
    "terminal": ["terminal.plain", "terminal.circle-dot"],
    "port": ["port.circle-sine-box*4", "port.circle-sine"],
    "source-ac": ["source-ac.plain", "source-ac.sine-marks", "source-ac.pulse"],
    "source-dc": ["source-dc.plain", "source-dc.circle-bar"],
    "source-current": ["source-current.plain"],
    "diode": ["diode.plain", "diode.zener"],
    "bjt-npn": ["bjt-npn.plain"],
    "bjt-pnp": ["bjt-pnp.plain"],
    "fet-n": ["fet-n.plain", "fet-n.mesfet"],
    "fet-p": ["fet-p.plain"],
    "amplifier": ["amplifier.plain"],
    "op-amp": ["op-amp.marks"],
    "block": ["block.plain"],
    "tline": ["tline.two-line", "tline.plain"],
    "mlin": ["mlin.parallelogram*3", "mlin.plain"],
    "mtee": ["mtee.box", "mtee.plain"],
    "mcross": ["mcross.box", "mcross.plain"],
    "mbend": ["mbend.mitre"],
    "mstep": ["mstep.taper", "mstep.plain"],
    "stub-open": ["stub-open.line-circle", "stub-open.plain"],
    "stub-short": ["stub-short.ground-down"],
    "via": ["via.ground"],
    "transformer": ["transformer.plain"],
    "attenuator": ["attenuator.pad"],
    "filter": ["filter.curve"],
    "switch": ["switch.plain"],
    "circulator": ["circulator.plain"],
    "coupler": ["coupler.lines"],
    "mixer": ["mixer.plain"],
    "probe": ["probe.circle-arrow"],
    "controller": ["controller.shadow*3", "controller.bracket"],
    "no-connect": ["no-connect.plain"]
  },
  "substitute": { "stub-short": 1, "op-amp": 0.2 },
  "distractors": { "controller": 0.7, "note": 0.2, "title": 0.15, "frame": 0.06, "probe": 0.06, "ring": 0.04, "arrows": 0.04, "chrome": 0.15, "twoCircuits": 0.04 },
  "controllerTitles": ["s-parameter simulation", "s-parameter simulation", "transient simulation", "equation", "parameter sweep", "SUBSTRATE"]
}
