{
  "name": "iec-boxes",
  "about": "The box convention: hollow box resistors, filled box inductors, flat-plate capacitors, flat or chassis grounds, open-circle terminals, words in an oblique or condensed face with letter-as-point values (22R, 4n7), drawn with any pen from a hairline to a heavy one.",
  "families": ["corpus-web", "family-e"],
  "medium": "document",
  "weight": 1,
  "palettes": [
    { "paper": "#ffffff", "grid": "#ffffff", "wire": "#000000", "symbol": "#000000", "text": ["#000000"], "type": "#000000", "fill": "#000000", "accent": "#000000" },
    { "paper": "#fbfbf7", "grid": "#fbfbf7", "wire": "#1a1a1a", "symbol": "#1a1a1a", "text": ["#1a1a1a", "#3050a0"], "type": "#1a1a1a", "fill": "#1a1a1a", "accent": "#3050a0" }
  ],
  "canvas": { "grid": "none", "frame": 0.05, "titleBlock": 0.3 },
  "pens": { "wire": [0.01, 0.08], "symbol": [0.01, 0.08], "minPx": [1, 2.5], "caps": { "butt": 1, "round": 1 }, "antialias": 0.85, "symbolScale": [0.75, 1] },
  "text": {
    "fonts": { "sans-oblique": 2, "condensed": 2, "sans": 1, "condensed-oblique": 1 }, "size": [0.6, 1.0],
    "stacks": [ { "lines": ["designator", "value"], "weight": 3 }, { "lines": ["designator", "value"], "row": true, "weight": 1 } ],
    "placement": { "above": 2, "side": 2 },
    "valueForms": { "letter": 3, "spice": 2, "bare": 1 }, "ohm": { "Ω": 1, "": 1 }, "micro": { "µ": 1, "u": 1 }, "subscripts": 0.3,
    "netLabels": { "text": 2, "terminal": 2, "power-port": 1 }
  },
  "junctions": { "dots": { "circle": 3, "square": 1 }, "size": [0.1, 0.2], "pinMarkers": "none", "hops": 0.15 },
  "glyphs": {
    "resistor": ["resistor.box*3", "resistor.box-slim", "resistor.box-long"],
    "capacitor": ["capacitor.plain*2", "capacitor.thick", "capacitor.wide-gap"],
    "capacitor-polarised": ["capacitor-polarised.box-plate*2", "capacitor-polarised.filled-plate"],
    "inductor": ["inductor.block*3", "inductor.plain"],
    "ground": ["ground.flat*2", "ground.chassis", "ground.plain"],
    "terminal": ["terminal.plain*3", "terminal.square"],
    "power-port": ["power-port.bar*2", "power-port.circle"],
    "port": ["port.box", "port.circle-sine"],
    "source-ac": ["source-ac.plain", "source-ac.sine-marks"],
    "source-dc": ["source-dc.circle-bar", "source-dc.plain"],
    "source-current": ["source-current.double-circle*2", "source-current.plain"],
    "diode": ["diode.plain", "diode.filled"],
    "bjt-npn": ["bjt-npn.circle*2", "bjt-npn.open-arrow"],
    "bjt-pnp": ["bjt-pnp.circle", "bjt-pnp.open-arrow"],
    "fet-n": ["fet-n.circle", "fet-n.plain"],
    "fet-p": ["fet-p.circle"],
    "amplifier": ["amplifier.box", "amplifier.plain"],
    "op-amp": ["op-amp.plain"],
    "ic-box": ["ic-box.plain"],
    "block": ["block.plain", "block.double"],
    "tline": ["tline.long", "tline.plain"],
    "mlin": ["mlin.filled", "mlin.plain"],
    "mtee": ["mtee.filled"],
    "mcross": ["mcross.filled"],
    "mbend": ["mbend.filled"],
    "mstep": ["mstep.filled"],
    "stub-open": ["stub-open.filled"],
    "stub-short": ["stub-short.end-bar"],
    "via": ["via.box-x"],
    "transformer": ["transformer.no-core", "transformer.plain"],
    "attenuator": ["attenuator.arrow", "attenuator.plain"],
    "filter": ["filter.two-wave"],
    "circulator": ["circulator.y"],
    "switch": ["switch.no-dots"],
    "switch-spdt": ["switch-spdt.no-dots"],
    "coupler": ["coupler.plain"],
    "balun": ["balun.coils"],
    "mixer": ["mixer.small-x"],
    "no-connect": ["no-connect.bold"]
  },
  "substitute": { "capacitor-polarised": 0.15, "stub-short": 1, "ic-box": 0.3, "op-amp": 0.15 },
  "distractors": { "caption": 0.35, "note": 0.1, "arrows": 0.25, "frame": 0.1, "title": 0.08, "twoCircuits": 0.12 }
}
