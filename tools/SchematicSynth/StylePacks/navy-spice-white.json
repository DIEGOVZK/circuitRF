{
  "name": "navy-spice-white",
  "about": "The same circuit simulator on a white canvas with a dot grid: blue wires, navy symbols, coloured flags for named nets, green or blue squares where nets join, bold words, a dot directive below.",
  "families": ["family-c"],
  "medium": "screen",
  "weight": 0.8,
  "palettes": [
    { "paper": "#ffffff", "grid": "#a0a0a0", "wire": "#0000ff", "symbol": "#000080", "text": ["#000000"], "type": "#000000", "fill": "#ffff99", "accent": "#0000ff" },
    { "paper": "#ffffff", "grid": "#b0b0b0", "wire": "#008000", "symbol": "#c00000", "text": ["#000000", "#e0006a"], "type": "#000000", "fill": "#ffffa0", "accent": "#e0006a" }
  ],
  "canvas": { "grid": { "dots": 0.7, "none": 0.3 }, "gridPitch": [0.5, 1] },
  "pens": { "wire": [0.005, 0.01], "symbol": [0.005, 0.01], "minPx": [1, 2], "caps": "butt", "antialias": 0.5, "symbolScale": [0.9, 1] },
  "text": {
    "fonts": { "sans-bold": 3, "sans": 1 }, "size": [0.6, 1.0],
    "stacks": [ { "lines": ["designator", "value"], "weight": 4 }, { "lines": ["designator", "value"], "row": true, "weight": 1 } ],
    "placement": "side",
    "valueForms": { "spice": 4, "letter": 1 }, "ohm": { "": 3, "Ω": 1 }, "micro": { "µ": 1, "u": 1 },
    "netLabels": { "text": 2, "terminal": 2, "power-port": 1 }
  },
  "junctions": { "dots": { "square": 1 }, "size": [0.12, 0.18], "pinMarkers": "none", "hops": 0 },
  "glyphs": {
    "resistor": ["resistor.zigzag-wide*2", "resistor.plain"],
    "capacitor": ["capacitor.plain", "capacitor.narrow"],
    "capacitor-polarised": ["capacitor-polarised.box-plate"],
    "inductor": ["inductor.loops*2", "inductor.loops-big"],
    "ground": ["ground.triangle*2", "ground.triangle-big"],
    "terminal": ["terminal.flag*3", "terminal.arrow"],
    "power-port": ["power-port.triangle-up*2", "power-port.open-arrow"],
    "source-ac": ["source-ac.circle-pm*2", "source-ac.sine-marks"],
    "source-dc": ["source-dc.battery-two", "source-dc.circle-pm*2"],
    "source-current": ["source-current.open-arrow"],
    "diode": ["diode.plain", "diode.zener"],
    "bjt-npn": ["bjt-npn.plain"],
    "fet-n": ["fet-n.plain"],
    "op-amp": ["op-amp.marks"],
    "ic-box": ["ic-box.filled"],
    "switch": ["switch.plain"],
    "switch-spdt": ["switch-spdt.plain"],
    "transformer": ["transformer.no-core"],
    "no-connect": ["no-connect.plain"]
  },
  "substitute": { "op-amp": 0.6, "ic-box": 0.5 },
  "distractors": { "directive": 0.6, "title": 0.25, "note": 0.1, "chrome": 0.25, "frame": 0.06, "twoCircuits": 0.04 }
}
