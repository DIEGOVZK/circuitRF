{
  "name": "blue-symbol-cyan-canvas",
  "about": "The same RF editor shown zoomed in on a cyan or lilac-grey canvas: large blue words, thin pink wires, dark-blue symbols, filled squares where nets join, an analysis block's icon and shadow.",
  "families": ["family-a"],
  "medium": "screen",
  "weight": 0.8,
  "palettes": [
    { "paper": "#b4ffff", "grid": "#70a0a0", "wire": "#d0007f", "symbol": "#000090", "text": ["#0000c0"], "type": "#2a6bff", "fill": "#d8e0ff", "accent": "#000000" },
    { "paper": "#ebe4ea", "grid": "#9a9a9a", "wire": "#c0006a", "symbol": "#00008b", "text": ["#0000c8", "#1050ff"], "type": "#4a8aff", "fill": "#c8d0ff", "accent": "#000000" }
  ],
  "canvas": { "grid": { "dots": 0.6, "none": 0.4 }, "gridPitch": [0.5, 1] },
  "pens": { "wire": [0.006, 0.012], "symbol": [0.008, 0.016], "minPx": [1.4, 2.4], "caps": "butt", "antialias": 0.7, "symbolScale": [0.85, 1] },
  "text": {
    "fonts": { "sans": 3, "ui": 1 }, "size": [0.75, 1.0],
    "stacks": [ { "lines": ["type", "designator", "values"], "weight": 3 }, { "lines": ["designator", "values"], "weight": 1 } ],
    "placement": "side",
    "valueForms": "named", "ohm": "Ohm", "micro": "u", "tags": 0.4,
    "netLabels": { "text": 3, "terminal": 1 }
  },
  "junctions": { "dots": { "square": 2, "none": 1 }, "size": [0.12, 0.18], "pinMarkers": { "square": 2, "none": 1 }, "hops": 0 },
  "glyphs": {
    "resistor": ["resistor.zigzag-short", "resistor.plain"],
    "capacitor": ["capacitor.plain"],
    "inductor": ["inductor.loops*2", "inductor.plain"],
    "ground": ["ground.bars-equal"],
    "terminal": ["terminal.hexagon"],
    "port": ["port.plain", "port.box-plus"],
    "source-ac": ["source-ac.plain"],
    "source-dc": ["source-dc.plain"],
    "source-current": ["source-current.open-arrow", "source-current.plain"],
    "bjt-npn": ["bjt-npn.plain"],
    "bjt-pnp": ["bjt-pnp.plain"],
    "fet-n": ["fet-n.mesfet"],
    "fet-p": ["fet-p.mesfet"],
    "diode": ["diode.filled"],
    "amplifier": ["amplifier.plain"],
    "block": ["block.plain", "block.shadow"],
    "tline": ["tline.plain"],
    "mlin": ["mlin.plain"],
    "mtee": ["mtee.plain"],
    "mcross": ["mcross.plain"],
    "mbend": ["mbend.plain"],
    "stub-open": ["stub-open.plain"],
    "probe": ["probe.plain"],
    "controller": ["controller.icon"],
    "no-connect": ["no-connect.small"]
  },
  "substitute": { "stub-short": 0 },
  "distractors": { "controller": 0.6, "title": 0.02, "frame": 0.08, "probe": 0.2, "ring": 0.08, "arrows": 0.05, "cursor": 0.05, "chrome": 0.1, "twoCircuits": 0.02 },
  "controllerTitles": ["S-PARAMETERS", "DC", "VAR", "HARMONIC BALANCE"]
}
