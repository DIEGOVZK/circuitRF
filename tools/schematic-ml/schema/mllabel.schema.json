{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://circuitrf.local/schema/mllabel-1.json",
  "title": "circuitRF schematic picture label, version 1",
  "description": "One file per picture (<id>.mllabel.json beside it). Every coordinate is in the picture's own pixels, origin top-left, x right, y down. docs/design/schematic-vision.md section 2.",
  "type": "object",
  "required": ["version", "image", "width", "height", "origin", "parts", "wires", "texts"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "image": { "type": "string", "minLength": 1, "description": "The picture's file name, relative to this label's folder." },
    "width": { "type": "integer", "minimum": 1 },
    "height": { "type": "integer", "minimum": 1 },
    "origin": { "enum": ["real", "synth"] },
    "family": { "type": ["string", "null"], "description": "family-a… for a real picture; null for a generated one." },
    "style": { "type": ["string", "null"], "description": "The style pack or theme a generated picture was drawn in; null for a real one." },
    "parts": { "type": "array", "items": { "$ref": "#/$defs/part" } },
    "wires": { "type": "array", "items": { "$ref": "#/$defs/wire" } },
    "junctions": { "type": "array", "items": { "$ref": "#/$defs/point" } },
    "crossings": { "type": "array", "items": { "$ref": "#/$defs/point" } },
    "texts": { "type": "array", "items": { "$ref": "#/$defs/text" } },
    "annotations": { "type": "array", "items": { "$ref": "#/$defs/annotation" } },
    "ignore": { "type": "array", "items": { "$ref": "#/$defs/box" } },
    "masks": {
      "type": "object",
      "description": "Exact per-pixel masks; present for generated pictures, absent for real ones.",
      "additionalProperties": false,
      "properties": {
        "wire": { "type": "string" },
        "symbol": { "type": "string" },
        "text": { "type": "string" },
        "annotation": { "type": "string" }
      }
    }
  },
  "$defs": {
    "number": { "type": "number" },
    "point": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
    "box": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4, "description": "[x0, y0, x1, y1]" },
    "part": {
      "type": "object",
      "required": ["id", "class", "orientation", "body", "pins"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "class": { "type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" },
        "variant": { "type": "string" },
        "orientation": {
          "type": "object",
          "required": ["turn", "mirror"],
          "additionalProperties": false,
          "properties": {
            "turn": { "enum": [0, 90, 180, 270], "description": "Clockwise quarter turns from the class's canonical orientation, applied after the mirror." },
            "mirror": { "type": "boolean", "description": "Reflected x -> 1-x in the canonical frame, before the turn." }
          }
        },
        "body": { "$ref": "#/$defs/box" },
        "pins": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "x", "y"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "x": { "type": "number" },
              "y": { "type": "number" }
            }
          }
        },
        "designator": { "type": ["string", "null"], "description": "The id of the text that is this part's designator." },
        "values": { "type": "array", "items": { "type": "string" }, "description": "The ids of the texts that are this part's values." },
        "params": { "type": "object", "additionalProperties": { "type": "string" }, "description": "Parameter values in base SI, as text." },
        "cut": { "type": "boolean", "description": "The picture's edge cuts this part." }
      }
    },
    "wire": {
      "type": "object",
      "required": ["points"],
      "additionalProperties": false,
      "properties": {
        "points": { "type": "array", "items": { "$ref": "#/$defs/point" }, "minItems": 2 },
        "pen": { "type": "number", "exclusiveMinimum": 0, "description": "The drawn stroke width in pixels." }
      }
    },
    "text": {
      "type": "object",
      "required": ["id", "quad", "string", "role"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "quad": { "type": "array", "items": { "$ref": "#/$defs/point" }, "minItems": 4, "maxItems": 4, "description": "Corners in reading order: top-left, top-right, bottom-right, bottom-left of the line as read." },
        "string": { "type": ["string", "null"], "description": "The line as drawn, characters in reading order, sub- and superscripts inline; null when it cannot be read (the role is kept)." },
        "role": { "enum": ["designator", "value", "net", "port", "pin-number", "pin-name", "title", "other"] }
      }
    },
    "annotation": {
      "type": "object",
      "required": ["box", "kind"],
      "additionalProperties": false,
      "properties": {
        "box": { "$ref": "#/$defs/box" },
        "kind": { "enum": ["arrow", "frame", "chrome", "title", "other"] }
      }
    }
  }
}
