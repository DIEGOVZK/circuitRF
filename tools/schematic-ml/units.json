{
  "version": 1,
  "about": "The value grammar's unit table, shared by the training kit's Python port (crfml/values.py) and circuitRF's own reader (ValueGrammar, through BomTablePaste). tests/Ui.Tests/Vision/UnitsTableTests reads this file and holds it to the C# grammar; crfml.selftest holds the Python port to it. Change both sides and this file together.",
  "prefixScale": { "f": 1e-15, "p": 1e-12, "n": 1e-9, "µ": 1e-6, "m": 1e-3, "k": 1e3, "M": 1e6, "G": 1e9 },
  "ohmWords": ["ohms", "ohm", "Ω"],
  "ohmPrefixes": { "": "", "m": "m", "k": "k", "K": "k", "M": "M", "G": "G" },
  "faradHenryPrefixes": { "": "", "f": "f", "p": "p", "P": "p", "n": "n", "N": "n", "u": "µ", "U": "µ", "µ": "µ", "μ": "µ", "m": "m" },
  "femtoOnlyFarads": true,
  "letterAsPoint": {
    "letters": "pnuµμmkKMGRPNU",
    "resistorLetters": { "R": "", "m": "m", "k": "k", "K": "k", "M": "M", "G": "G" },
    "unitlessResistorLetters": "RkKMG"
  },
  "notFittedWords": ["dnp", "dnf", "dni", "dnm", "nofit", "notfitted", "donotpopulate", "donotfit", "donotmount", "nc", "np", "nm",
                     "notassembled", "notmounted", "notplaced", "notpopulated", "unpopulated", "nopop", "nopopulate"],
  "lineLengths": [ ["mm", 1e-3], ["µm", 1e-6], ["μm", 1e-6], ["um", 1e-6], ["nm", 1e-9], ["cm", 1e-2], ["mil", 25.4e-6], ["in", 25.4e-3], ["m", 1] ],
  "lineFrequencies": [ ["GHz", 1e9], ["MHz", 1e6], ["kHz", 1e3], ["THz", 1e12], ["Hz", 1] ],
  "examples": [
    { "text": "100pF",    "si": 1e-10,   "dims": ["Capacitance"] },
    { "text": "100 pF",   "si": 1e-10,   "dims": ["Capacitance"] },
    { "text": "0.77pF",   "si": 7.7e-13, "dims": ["Capacitance"] },
    { "text": "10uF",     "si": 1e-5,    "dims": ["Capacitance"] },
    { "text": "4.7µH",    "si": 4.7e-6,  "dims": ["Inductance"] },
    { "text": "27nH",     "si": 2.7e-8,  "dims": ["Inductance"] },
    { "text": "1fF",      "si": 1e-15,   "dims": ["Capacitance"] },
    { "text": "49.9Ω",    "si": 49.9,    "dims": ["Resistance"] },
    { "text": "10\u2126",  "si": 10,      "dims": ["Resistance"] },
    { "text": "1kΩ",      "si": 1000,    "dims": ["Resistance"] },
    { "text": "2.2 kohm", "si": 2200,    "dims": ["Resistance"] },
    { "text": "100R",     "si": 100,     "dims": ["Resistance"] },
    { "text": "4k7",      "si": 4700,    "dims": ["Resistance"] },
    { "text": "2R2",      "si": 2.2,     "dims": ["Resistance"] },
    { "text": "1k",       "si": 1000,    "dims": ["Resistance"] },
    { "text": "10p",      "si": 1e-11,   "dims": ["Capacitance", "Inductance"] },
    { "text": "2n2",      "si": 2.2e-9,  "dims": ["Capacitance", "Inductance"] },
    { "text": "R=17.4Ω",  "si": 17.4,    "dims": ["Resistance"] },
    { "text": "C=0.5pF",  "si": 5e-13,   "dims": ["Capacitance"] },
    { "text": "DNP",      "si": 0,       "dims": [], "notFitted": true },
    { "text": "Z=50Ω,E=90°", "line": [ ["Z", 50, "Resistance"], ["E", 90, "Angle"] ] },
    { "text": "W=0.3mm L=3.2mm", "line": [ ["W", 0.0003, "Length"], ["L", 0.0032, "Length"] ] },
    { "text": "F=2GHz",   "line": [ ["F", 2e9, "Frequency"] ] }
  ],
  "rejects": ["10", "1MF", "1fH", "abc", "1xF", "R1", "Z=5GΩ"]
}
